#!/usr/bin/env python3
"""Pick, install and report the local tier.

`pick` chooses the English tier this machine runs best from its GPU memory,
RAM and CPU threads. `choices` prints one JSON object for the service: the
pick, the tier ready now (null for none) and the Local voice setting's offers,
`auto` labelled with the pick first, then every other tier this machine can
run, in declaration order. The TUI calls `install [TIER]`; with no tier it
installs the pick. The service calls `status`, which emits one status value
for localRuntime. `probe` runs only inside a network namespace. Exit 77 means
unavailable, never ready. No audio device or host setting is opened. The
state lock covers invalidation, installation and publication.
"""
import argparse
import fcntl
from functools import cache
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tarfile
import tempfile
import time
from urllib.parse import urlparse

HERE = Path(__file__).resolve().parent
sys.dont_write_bytecode = True
# Each English tier's measured need, in MiB. Measured by measure-local on host
# cachy (AMD Ryzen 9 9950X, 32 threads, RTX 5090) on 2026-09-30 for VGS-651:
# the tier's whole resident set on a 60 s input with 2 inference threads.
# medium's warm turn took 10.971 s there; large's GPU figure is a sampled peak.
NEED = {"small": {"ram": 1813.71}, "medium": {"ram": 3303.58}, "large": {"ram": 3782.72, "gpu": 4004.00}}
# The voice holds at most an eighth of RAM, leaving the rest to the desktop,
# the browser and the AI app.
RAM_SHARE = 8
# The sampled GPU peak is a lower bound, the CUDA context keeps about 627 MB
# after unload, and the desktop shares the card.
GPU_SHARE = 2
# medium's turn time was measured only on a 32-thread machine; no reading
# proves it on fewer.
MEDIUM_THREADS = 32
# How long install waits for the state lock, in seconds. A status or choices
# read holds it shared for one verification of the ready tier, and a
# requirement scan starts both; an install holds it for its whole download,
# so a second install still ends busy. The bound is chosen, not measured.
LOCK_WAIT = 30
# One tier's environment and models. uv's cache and managed Python stay.
RUNTIME = ("venv", "models", "requirements-cuda.lock")


@cache
def measurement():
    """Load the one artifact judge and bundled-clip oracle."""
    loader = importlib.machinery.SourceFileLoader("jarvis_measure", str(HERE / "measure-local"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def roots():
    """Use the same state and data roots as the service's hello."""
    home = Path(os.environ["HOME"])
    state = Path(os.environ.get("XDG_STATE_HOME") or home / ".local/state") / "vgshell/jarvis"
    data = Path(os.environ.get("XDG_DATA_HOME") or home / ".local/share") / "vgshell/jarvis/local"
    return state, data


def selected(value, tier):
    """Take membership and provider from the artifact producer."""
    row = value["tiers"][tier]
    by_id = {artifact["id"]: artifact for artifact in value["artifacts"]}
    return [by_id[name] for name in row["artifacts"]], row["provider"]


def environment(data, offline=False):
    """Children receive no account, audio, desktop or authentication endpoint."""
    env = {key: os.environ[key] for key in ("PATH", "HOME") if key in os.environ}
    env.update(LC_ALL="C.UTF-8", UV_NO_CONFIG="1",
               UV_CACHE_DIR=str(data / "cache"), UV_PYTHON_INSTALL_DIR=str(data / "python"))
    if offline:
        state, _ = roots()
        env.update(XDG_STATE_HOME=str(state.parents[1].resolve()),
                   XDG_DATA_HOME=str(data.parents[2].resolve()),
                   HF_HUB_OFFLINE="1", TRANSFORMERS_OFFLINE="1")
    return env


class ChildFailed(SystemExit):
    """A child's nonzero exit, apart from a cancel's; the process exits with it."""


def command(argv, data, offline=False, stderr=None, stdout=None):
    """Preserve every child failure, including unavailable evidence."""
    result = subprocess.run(argv, env=environment(data, offline), stderr=stderr, stdout=stdout, check=False)
    if result.returncode != 0:
        raise ChildFailed(result.returncode if result.returncode > 0 else 1)


def machine(judge, data):
    """Read what decides the tiers this machine runs: GPU memory, RAM, threads.

    `gpu` is the least total memory, in MiB, of the GPUs the plugin's declared
    nvidia-smi requirement lists, or None when it is missing, fails or lists
    none. `threads` is the machine's, not this process's affinity.
    """
    try:
        # NVIDIA documents --query-gpu memory.total in MiB, one line a GPU.
        child = judge.gpu_query("--query-gpu=memory.total", environment(data))
        gpus = [int(line) for line in child.stdout.split()]
    except (OSError, ValueError, subprocess.SubprocessError):
        gpus = []
    return {"gpu": min(gpus) if gpus else None, "ram": judge.meminfo("MemTotal") / 2**20,
            "threads": os.cpu_count()}


def pick(reading):
    """The English tier READING runs best; multilingual is the user's choice.

    large needs a GPU with GPU_SHARE times its sampled peak, medium a
    MEDIUM_THREADS machine, and each a RAM_SHARE share of RAM for its peak;
    small is the floor.
    """
    if (reading["gpu"] is not None and reading["gpu"] >= GPU_SHARE * NEED["large"]["gpu"]
            and reading["ram"] >= RAM_SHARE * NEED["large"]["ram"]):
        return "large"
    if (reading["ram"] >= RAM_SHARE * NEED["medium"]["ram"]
            and reading["threads"] is not None and reading["threads"] >= MEDIUM_THREADS):
        return "medium"
    return "small"


def runnable(provider, reading):
    """Whether a machine READING can run a provider's tiers.

    CUDA needs nvidia-smi to list a GPU. A listed GPU does not prove the CUDA
    libraries load; the probe still judges.
    """
    if provider == "cpu":
        return True
    if provider != "cuda":
        raise ValueError(f"tier-provider=invalid provider={provider}")
    return reading["gpu"] is not None


def size(count):
    """Decimal units, as download sizes are quoted."""
    if round(count / 10**6) < 1000:
        return f"{round(count / 10**6)} MB"
    return f"{count / 10**9:.1f} GB"


def stored(*roots):
    """Bytes of the regular files below roots, not following links."""
    return sum(path.lstat().st_size for root in roots for path in root.rglob("*")
               if path.is_file() and not path.is_symlink())


def choices(value, reading, ready):
    """The Local voice setting's offers for READING, with the pick and READY.

    `auto` stands for the pick and comes first; the pick is not offered again.
    """
    best = pick(reading)

    def label(lead, row):
        return f"{lead}{row['description']}, {size(row['downloadBytes'])}"

    offers = [{"value": "auto", "label": label(f"Auto: {value['tiers'][best]['name']}, ", value["tiers"][best])}]
    offers += [{"value": tier, "label": label(f"{row['name']}: ", row)}
               for tier, row in value["tiers"].items() if tier != best and runnable(row["provider"], reading)]
    return {"pick": best, "ready": ready, "choices": offers}


def remove_runtime(data):
    """Remove one tier's environment, models and projected lock."""
    for name in RUNTIME:
        path = data / name
        if path.is_dir():
            shutil.rmtree(path)
        else:
            path.unlink(missing_ok=True)


def download(url, target, digest, judge, data):
    """curl writes a private partial; only verified bytes get their final name."""
    partial = target.with_name(target.name + ".partial")
    try:
        command(["curl", "--disable", "--fail", "--location", "--proto", "=https",
                 "--proto-redir", "=https", "--output", str(partial), "--", url], data)
        if judge.sha256(partial) != digest:
            raise ValueError(f"download=hash-mismatch file={target.name}")
        partial.replace(target)
    finally:
        partial.unlink(missing_ok=True)


def extract(archive, models):
    """Pinned upstream tarballs may write only ordinary files below models."""
    with tarfile.open(archive) as bundle:
        for member in bundle:
            path = Path(member.name)
            if path.is_absolute() or ".." in path.parts or not (member.isdir() or member.isfile()):
                raise ValueError(f"archive=unsafe-member file={member.name}")
        bundle.extractall(models, filter="data")


def identity(judge, tier, data):
    """Bind readiness to setup sources, fixture, lock and installed runtime bytes.

    Bytecode caches are derived from the installed sources and vary on import.
    The interpreter target, venv configuration and all other environment files
    are inputs. A changed model is checked by the existing local verifier.
    """
    sources = ["artifacts.json", "requirements-local.lock", "requirements-local-cpu.lock",
               "setup-local", "measure-local"]
    value = judge.manifest(HERE / "artifacts.json")
    sources += [value["fixture"]["audio"], value["fixture"]["transcript"]]
    runtime = data / "venv"
    files = sorted(path for path in runtime.rglob("*")
                   if path.is_file() and "__pycache__" not in path.parts and path.suffix != ".pyc")
    if not files or not (runtime / "bin/python").is_file():
        raise judge.Unavailable("runtime=missing")
    digest = hashlib.sha256()
    for path, name in [(HERE / name, name) for name in sources] + [
            (path, "venv/" + str(path.relative_to(runtime))) for path in files]:
        digest.update(name.encode() + b"\0" + judge.sha256(path).encode() + b"\0")
    digest.update(str((runtime / "bin/python").resolve()).encode())
    return {"schemaVersion": 1, "tier": tier, "data": str(data.resolve()),
            "inputs": digest.hexdigest()}


def probe(judge, value, tier, data):
    """Execute the selected installed runtime, with the shared real clip probe."""
    artifacts, provider = selected(value, tier)
    judge.run(value, artifacts, data / "models", provider, None, tier)


def install(judge, state, data, tier, reading):
    """Refuse before any effect, invalidate, and publish only after real inference.

    A refused attempt keeps an earlier ready installation. A failed one removes
    this tier's environment and models and states what it kept for reuse.
    """
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (state / "local-setup.lock").open("a") as lock:
        deadline = time.monotonic() + LOCK_WAIT
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise ValueError("setup=busy") from None
                time.sleep(0.1)
        value = judge.manifest(HERE / "artifacts.json")
        artifacts, provider = selected(value, tier)
        if not runnable(provider, reading):
            raise ValueError(f"gpu=unavailable tier={tier}\n"
                             "This model needs an NVIDIA graphics card, which this computer does not have. "
                             "Under Local voice on the Jarvis page, choose a model that runs on any computer.")
        data.mkdir(parents=True, exist_ok=True, mode=0o700)
        # Setup holds about twice the download at its peak: archives beside
        # their extracted models and uv's cache beside the environment. A
        # 2.26 GB download measured 4.2 GB on disk after setup. The runtime
        # and models this attempt replaces free their bytes first.
        need = 2 * value["tiers"][tier]["downloadBytes"] - stored(*(data / name for name in RUNTIME))
        free = shutil.disk_usage(data).free
        if free < need:
            raise ValueError(f"disk=insufficient need={need} free={free} path={data}\n"
                             f"This tier needs {size(need)} free in {data}, which has {size(free)}. "
                             "Free some space, or choose a smaller model under Local voice on the Jarvis page.")
        marker = state / "local-ready.json"
        marker.unlink(missing_ok=True)
        judge.clip(value)
        try:
            remove_runtime(data)
            models = data / "models"
            models.mkdir(mode=0o700)
            python = data / "venv/bin/python"
            abi = value["runtimes"]["sherpa-onnx"]["cudaWheel"]["python"]
            print("jarvis-setup: step=runtime", flush=True)
            command(["uv", "--no-config", "venv", "--managed-python", "--python", abi,
                     str(data / "venv")], data)
            if provider == "cpu":
                requirements = HERE / "requirements-local-cpu.lock"
            else:
                wheel = value["runtimes"]["sherpa-onnx"]["cudaWheel"]
                requirements = data / "requirements-cuda.lock"
                requirements.write_text((HERE / "requirements-local.lock").read_text() +
                    f"\nsherpa-onnx @ {wheel['url']} --hash=sha256:{wheel['sha256']}\n")
            command(["uv", "--no-config", "pip", "sync", "--python", str(python),
                     "--require-hashes", "--only-binary", ":all:", str(requirements)], data)
            for artifact in artifacts:
                print(f"jarvis-setup: step=model id={artifact['id']}", flush=True)
                target = models / Path(urlparse(artifact["url"]).path).name
                download(artifact["url"], target, artifact["sha256"], judge, data)
                if artifact["directory"] != ".":
                    extract(target, models)
            judge.verify(value, models, artifacts)
            ready = identity(judge, tier, data)
            print("jarvis-setup: step=probe", flush=True)
            # The owner reads the plain line; the engine's own lines go to the log.
            log = state / "local-setup.log"
            with log.open("w") as output, tempfile.TemporaryFile(mode="w+") as reading:
                try:
                    command(["unshare", "-rn", "--", str(python), "-I", str(HERE / "setup-local"),
                             "probe", tier], data, offline=True, stderr=output, stdout=reading)
                except ChildFailed:
                    # Only a CUDA tier has a tier that runs on any computer to fall back to.
                    advice = (" Under Local voice on the Jarvis page, choose a model that runs on any computer."
                              if provider == "cuda" else "")
                    print(f"jarvis-setup: failed=probe log={log}\n"
                          f"Local voice did not pass its test on this computer. The details are in {log}." + advice,
                          file=sys.stderr)
                    raise
                reading.seek(0)
                need = judge.memory_need(json.load(reading), value, tier)
            judge.verify(value, models, artifacts)
            if ready != identity(judge, tier, data):
                raise ValueError("runtime=changed-during-probe")
            ready["memory"] = need
            with tempfile.NamedTemporaryFile(mode="w", dir=state, prefix=".local-ready-", delete=False) as output:
                temporary = Path(output.name)
                try:
                    json.dump(ready, output)
                    output.flush()
                    os.fsync(output.fileno())
                    temporary.replace(marker)
                finally:
                    temporary.unlink(missing_ok=True)
        except BaseException:
            remove_runtime(data)
            kept = stored(data)
            print(f"jarvis-setup: kept={data} bytes={kept}\n"
                  f"Removed the downloaded models and runtime. Kept {size(kept)} of downloads in {data}; "
                  "the next setup reuses them.", file=sys.stderr)
            raise
        print("jarvis-setup: ready=" + tier, flush=True)


def status(judge, state, data):
    """A missing, busy, stale or unverifiable installation never reports ready."""
    report = {"tone": "warning", "text": "Not set up", "action": True}
    marker = state / "local-ready.json"
    if not state.is_dir():
        return report
    with (state / "local-setup.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            return {"tone": "info", "text": "Setting up", "action": False}
        if not marker.is_file():
            return report
        try:
            saved = json.loads(marker.read_text())
            tier = saved["tier"]
            value = judge.manifest(HERE / "artifacts.json")
            artifacts, _ = selected(value, tier)
            judge.validate_memory(saved["memory"], value["tiers"][tier]["provider"])
            if {key: item for key, item in saved.items() if key != "memory"} != identity(judge, tier, data):
                raise ValueError("marker=stale")
            judge.clip(value)
            judge.verify(value, data / "models", artifacts)
            return {"tone": "ok", "text": "Ready: " + tier, "action": False}
        except (ValueError, KeyError, TypeError, OSError, judge.Unavailable):
            return {"tone": "warning", "text": "Setup needs verification", "action": True}


def ready_tier(judge, state, data):
    """The tier status verifies ready, None for none; its marker names it."""
    if status(judge, state, data)["tone"] != "ok":
        return None
    return json.loads((state / "local-ready.json").read_text())["tier"]


def main():
    """Keep chosen tiers within the producer's current declaration."""
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("verb", choices=("choices", "install", "status", "probe"))
    parser.add_argument("tier", nargs="?")
    args = parser.parse_args()
    judge = measurement()
    state, data = roots()
    if args.verb in ("choices", "status") and args.tier is not None:
        parser.error(f"{args.verb} takes no tier")
    if args.verb == "choices":
        ready = ready_tier(judge, state, data)
        print(json.dumps(choices(judge.manifest(HERE / "artifacts.json"), machine(judge, data), ready)))
        return
    if args.verb == "status":
        print(json.dumps(status(judge, state, data)))
        return
    if args.verb == "probe":
        value = judge.manifest(HERE / "artifacts.json")
        probe(judge, value, args.tier, data)
    else:
        reading = machine(judge, data)
        install(judge, state, data, pick(reading) if args.tier is None else args.tier, reading)


if __name__ == "__main__":
    # A cancelled setup cannot publish its marker after the terminal closes.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    signal.signal(signal.SIGHUP, lambda *_: sys.exit(129))
    try:
        main()
    except measurement().Unavailable as error:
        print(f"jarvis-setup: unavailable={error}", file=sys.stderr)
        sys.exit(77)
    except (ValueError, KeyError, TypeError, OSError, tarfile.TarError) as error:
        print(f"jarvis-setup: failed={error}", file=sys.stderr)
        sys.exit(1)
