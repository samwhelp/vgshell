#!/usr/bin/env python3
"""Pick, install and report the local tier.

`pick` chooses the English tier this machine runs best from its GPU memory,
RAM and CPU threads. `choices` prints one JSON object for the service: the
pick, the tier ready now (null for none) and the Local voice setting's offers,
`auto` labelled with the pick first, then every other tier this machine can
run, in declaration order. The TUI calls `install [TIER]`; with no tier it
installs the pick. The service calls `status`, which emits one status value
for localRuntime. `probe` runs only inside a network namespace. Exit 77 means
unavailable, never ready. No audio device or host setting is opened. The
state lock covers invalidation, installation and publication.

`clone` holds the cloned voice's verbs, under a lock of their own:
`install` builds its environment and fetches its model beside a ready
graphics card tier, `record` stores the reference read on stdin and
publishes after a probe, `probe` runs only inside a network namespace,
`remove` deletes the recording and `status` emits clonedVoiceSetup's value.
"""
import argparse
from array import array
from contextlib import contextmanager
import fcntl
from functools import cache
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import shutil
import signal
import stat
import subprocess
import sys
import tarfile
import tempfile
import time
from urllib.parse import urlparse
import wave

HERE = Path(__file__).resolve().parent
sys.dont_write_bytecode = True
# Each tier's measured need, in MiB. Measured by measure-local on host cachy
# (AMD Ryzen 9 9950X, 32 threads, RTX 5090) on 2026-10-12 for VGS-1235: the
# tier's whole resident set on a 60 s input with 2 inference threads.
# medium's warm turn took 7.245 s there; large's GPU figure is a sampled peak.
NEED = {"small": {"ram": 1289.95}, "medium": {"ram": 1680.33}, "large": {"ram": 2587.48, "gpu": 1898.00}}
# The voice holds at most an eighth of RAM, leaving the rest to the desktop,
# the browser and the AI app.
RAM_SHARE = 8
# The sampled GPU peak is a lower bound, the CUDA context kept 546 MiB after
# unload in that run, and the desktop shares the card. The share covers
# dictation's model too: the local voice needs its recording, and the card
# holds both at once.
GPU_SHARE = 2
# Dictation's Parakeet, resident on the card while voxtype runs
# (config/voxtype/config.toml on_demand_loading = false), in MiB:
# voxtype-onnx-cuda-13 in nvidia-smi --query-compute-apps on host cachy on
# 2026-10-12 for VGS-1235, beside the loaded large-tier sidecar.
DICTATION_GPU = 3854
# medium's turn time was measured only on a 32-thread machine; no reading
# proves it on fewer.
MEDIUM_THREADS = 32
# How long install waits for the state lock, in seconds. A status or choices
# read holds it shared for one verification of the ready tier, and a
# requirement scan starts both; an install holds it for its whole download,
# so a second install still ends busy. The bound is chosen, not measured.
LOCK_WAIT = 30
# One tier's environment and models. uv's cache and managed Python stay.
RUNTIME = ("venv", "models", "requirements-cuda.lock")
# The cloned voice's artifact, the folder below the data root that holds its
# environment, models and projected lock, and the provider it runs on: on
# the CPU VGS-1384 read a real-time factor of 3.08 at 32 threads.
CLONE_ID = "chatterbox"
CLONE = "clone"
CLONE_RUNTIME = ("venv", "models", "requirements-clone.lock")
CLONE_PROVIDER = "cuda"
# The recording, its marker and the lock of the clone verbs, in the state root.
REFERENCE = "voice-reference.wav"
CLONE_MARKER = "clone-ready.json"
CLONE_LOCK = "clone-setup.lock"
# The reference: mono s16 at the speech encoder's 24000 Hz. VGS-1384's
# reference was 8.54 s; the TUI records 10 s. Shorter than 5 s leaves the
# encoder little of the voice, longer than 15 s is not what the TUI records.
# A peak below a hundredth of full scale, -40 dBFS, is a muted or absent
# microphone, not a voice. Both bounds are chosen, not measured.
REFERENCE_RATE = 24000
REFERENCE_SECONDS = (5, 15)
REFERENCE_PEAK = 32768 // 100


@cache
def measurement():
    """Load the one artifact judge and bundled-clip oracle."""
    loader = importlib.machinery.SourceFileLoader("jarvis_measure", str(HERE / "measure-local"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def roots():
    """Use the same state and data roots as the service's hello."""
    home = Path(os.environ["HOME"])
    state = Path(os.environ.get("XDG_STATE_HOME") or home / ".local/state") / "vgshell/jarvis"
    data = Path(os.environ.get("XDG_DATA_HOME") or home / ".local/share") / "vgshell/jarvis/local"
    return state, data


def selected(value, tier):
    """Take membership and provider from the artifact producer."""
    row = value["tiers"][tier]
    by_id = {artifact["id"]: artifact for artifact in value["artifacts"]}
    return [by_id[name] for name in row["artifacts"]], row["provider"]


def environment(data, offline=False):
    """Children receive no account, audio, desktop or authentication endpoint."""
    env = {key: os.environ[key] for key in ("PATH", "HOME") if key in os.environ}
    env.update(LC_ALL="C.UTF-8", UV_NO_CONFIG="1",
               UV_CACHE_DIR=str(data / "cache"), UV_PYTHON_INSTALL_DIR=str(data / "python"))
    if offline:
        state, _ = roots()
        env.update(XDG_STATE_HOME=str(state.parents[1].resolve()),
                   XDG_DATA_HOME=str(data.parents[2].resolve()),
                   HF_HUB_OFFLINE="1", TRANSFORMERS_OFFLINE="1")
    return env


class ChildFailed(SystemExit):
    """A child's nonzero exit, apart from a cancel's; the process exits with it."""


def command(argv, data, offline=False, stderr=None, stdout=None):
    """Preserve every child failure, including unavailable evidence."""
    result = subprocess.run(argv, env=environment(data, offline), stderr=stderr, stdout=stdout, check=False)
    if result.returncode != 0:
        raise ChildFailed(result.returncode if result.returncode > 0 else 1)


def machine(judge, data):
    """Read what decides the tiers this machine runs: GPU memory, RAM, threads.

    `gpu` is the least total memory, in MiB, of the GPUs the plugin's declared
    nvidia-smi requirement lists, or None when it is missing, fails or lists
    none. `threads` is the machine's, not this process's affinity.
    """
    try:
        # NVIDIA documents --query-gpu memory.total in MiB, one line a GPU.
        child = judge.gpu_query("--query-gpu=memory.total", environment(data))
        gpus = [int(line) for line in child.stdout.split()]
    except (OSError, ValueError, subprocess.SubprocessError):
        gpus = []
    return {"gpu": min(gpus) if gpus else None, "ram": judge.meminfo("MemTotal") / 2**20,
            "threads": os.cpu_count()}


def pick(reading):
    """The tier READING runs best.

    large needs a GPU with GPU_SHARE times its sampled peak and dictation's
    model, medium a MEDIUM_THREADS machine, and each a RAM_SHARE share of
    RAM for its peak; small is the floor.
    """
    if (reading["gpu"] is not None and reading["gpu"] >= GPU_SHARE * (NEED["large"]["gpu"] + DICTATION_GPU)
            and reading["ram"] >= RAM_SHARE * NEED["large"]["ram"]):
        return "large"
    if (reading["ram"] >= RAM_SHARE * NEED["medium"]["ram"]
            and reading["threads"] is not None and reading["threads"] >= MEDIUM_THREADS):
        return "medium"
    return "small"


def runnable(provider, reading):
    """Whether a machine READING can run a provider's tiers.

    CUDA needs nvidia-smi to list a GPU. A listed GPU does not prove the CUDA
    libraries load; the probe still judges.
    """
    if provider == "cpu":
        return True
    if provider != "cuda":
        raise ValueError(f"tier-provider=invalid provider={provider}")
    return reading["gpu"] is not None


def size(count):
    """Decimal units, as download sizes are quoted."""
    if round(count / 10**6) < 1000:
        return f"{round(count / 10**6)} MB"
    return f"{count / 10**9:.1f} GB"


def stored(*roots):
    """Bytes of the regular files below roots, not following links."""
    return sum(path.lstat().st_size for root in roots for path in root.rglob("*")
               if path.is_file() and not path.is_symlink())


def choices(value, reading, ready):
    """The Local voice setting's offers for READING, with the pick and READY.

    `auto` stands for the pick and comes first; the pick is not offered again.
    """
    best = pick(reading)

    def label(lead, row):
        return f"{lead}{row['description']}, {size(row['downloadBytes'])}"

    offers = [{"value": "auto", "label": label(f"Auto: {value['tiers'][best]['name']}, ", value["tiers"][best])}]
    offers += [{"value": tier, "label": label(f"{row['name']}: ", row)}
               for tier, row in value["tiers"].items() if tier != best and runnable(row["provider"], reading)]
    return {"pick": best, "ready": ready, "choices": offers}


def remove_runtime(data, names=RUNTIME):
    """Remove one tier's environment, models and projected lock."""
    for name in names:
        path = data / name
        if path.is_dir():
            shutil.rmtree(path)
        else:
            path.unlink(missing_ok=True)


def download(url, target, digest, judge, data):
    """curl writes a private partial; only verified bytes get their final name."""
    partial = target.with_name(target.name + ".partial")
    try:
        command(["curl", "--disable", "--fail", "--location", "--proto", "=https",
                 "--proto-redir", "=https", "--output", str(partial), "--", url], data)
        if judge.sha256(partial) != digest:
            raise ValueError(f"download=hash-mismatch file={target.name}")
        partial.replace(target)
    finally:
        partial.unlink(missing_ok=True)


def extract(archive, models):
    """Pinned upstream tarballs may write only ordinary files below models."""
    with tarfile.open(archive) as bundle:
        for member in bundle:
            path = Path(member.name)
            if path.is_absolute() or ".." in path.parts or not (member.isdir() or member.isfile()):
                raise ValueError(f"archive=unsafe-member file={member.name}")
        bundle.extractall(models, filter="data")


def identity_inputs(value, tier):
    """The manifest fields that select installed bytes for TIER."""
    artifacts, provider = selected(value, tier)
    wheel = value["runtimes"]["sherpa-onnx"]["cudaWheel"]
    runtime = {"python": wheel["python"]}
    if provider == "cuda":
        runtime.update(url=wheel["url"], sha256=wheel["sha256"])
    return {
        "provider": provider,
        "artifacts": [
            {key: artifact[key] for key in ("id", "url", "sha256", "directory")}
            for artifact in artifacts
        ],
        "cudaWheel": runtime,
    }


def identity(judge, tier, data):
    """Bind readiness to bytes that decide the installed runtime and models.

    The digest uses selected artifact URLs and hashes, lock and fixture bytes,
    installed runtime files and the resolved interpreter. Display text and
    setup code are excluded: each status read still verifies the models, the
    fixture and the installed runtime identity.
    """
    value = judge.manifest(HERE / "artifacts.json")
    hashed_files = [
        ("requirements-local.lock", HERE / "requirements-local.lock"),
        ("requirements-local-cpu.lock", HERE / "requirements-local-cpu.lock"),
        (value["fixture"]["audio"], HERE / value["fixture"]["audio"]),
        (value["fixture"]["transcript"], HERE / value["fixture"]["transcript"]),
    ]
    return {"schemaVersion": 1, "tier": tier, "data": str(data.resolve()),
            "inputs": installed(judge, identity_inputs(value, tier), hashed_files, data / "venv")}


def installed(judge, inputs, hashed_files, runtime):
    """The digest of INPUTS, each (name, path) of HASHED_FILES, every
    installed file of the environment RUNTIME and its resolved interpreter."""
    files = sorted(path for path in runtime.rglob("*")
                   if path.is_file() and "__pycache__" not in path.parts and path.suffix != ".pyc")
    if not files or not (runtime / "bin/python").is_file():
        raise judge.Unavailable("runtime=missing")
    digest = hashlib.sha256()
    digest.update(json.dumps(inputs, sort_keys=True).encode() + b"\0")
    for name, path in hashed_files + [
            ("venv/" + str(path.relative_to(runtime)), path) for path in files]:
        digest.update(name.encode() + b"\0" + judge.sha256(path).encode() + b"\0")
    digest.update(str((runtime / "bin/python").resolve()).encode())
    return digest.hexdigest()


def reuse(judge, value, models, artifacts):
    """Keep only selected artifacts the verifier already accepts."""
    verified = set()
    keep = set()
    if not models.is_dir():
        return verified
    for artifact in artifacts:
        try:
            judge.verify(value, models, [artifact])
        except (ValueError, OSError, tarfile.TarError, judge.Unavailable):
            continue
        verified.add(artifact["id"])
        keep.add(Path(urlparse(artifact["url"]).path).name)
        if artifact["directory"] != ".":
            keep.add(Path(artifact["directory"]).parts[0])
    for path in models.iterdir():
        if path.name in keep:
            continue
        if path.is_symlink():
            path.unlink()
        elif path.is_dir():
            shutil.rmtree(path)
        else:
            path.unlink(missing_ok=True)
    return verified


def probe(judge, value, tier, data):
    """Execute the selected installed runtime, with the shared real clip probe."""
    artifacts, provider = selected(value, tier)
    judge.run(value, artifacts, data / "models", provider, None, tier)


@contextmanager
def exclusive(path):
    """Hold the lock at PATH alone, waiting LOCK_WAIT for its readers."""
    with path.open("a") as lock:
        deadline = time.monotonic() + LOCK_WAIT
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise ValueError("setup=busy") from None
                time.sleep(0.1)
        yield


@contextmanager
def shared(path):
    """Hold the lock at PATH beside other readers; yield False while a setup holds it."""
    with path.open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            yield False
            return
        yield True


def room(data, need, advice):
    """Refuse a setup that needs NEED bytes more than DATA's file system has
    free; ADVICE is the plain sentence after the keyed line."""
    free = shutil.disk_usage(data).free
    if free < need:
        raise ValueError(f"disk=insufficient need={need} free={free} path={data}\n"
                         f"This setup needs {size(need)} free in {data}, which has {size(free)}. " + advice)


def install(judge, state, data, tier, reading):
    """Refuse before any effect, invalidate, and publish only after real inference.

    A refused attempt keeps an earlier ready installation. A failed one removes
    this tier's environment and models and states what it kept for reuse.
    """
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    with exclusive(state / "local-setup.lock"):
        value = judge.manifest(HERE / "artifacts.json")
        artifacts, provider = selected(value, tier)
        if not runnable(provider, reading):
            raise ValueError(f"gpu=unavailable tier={tier}\n"
                             "This model needs an NVIDIA graphics card, which this computer does not have. "
                             "Under Local voice on the Jarvis page, choose a model that runs on any computer.")
        data.mkdir(parents=True, exist_ok=True, mode=0o700)
        # Setup holds about twice the download at its peak: archives beside
        # their extracted models and uv's cache beside the environment. A
        # 2.26 GB download measured 4.2 GB on disk after setup. The runtime
        # and models this attempt replaces free their bytes first.
        room(data, 2 * value["tiers"][tier]["downloadBytes"] - stored(*(data / name for name in RUNTIME)),
             "Free some space, or choose a smaller model under Local voice on the Jarvis page.")
        marker = state / "local-ready.json"
        marker.unlink(missing_ok=True)
        judge.clip(value)
        try:
            models = data / "models"
            verified = reuse(judge, value, models, artifacts)
            remove_runtime(data, ("venv", "requirements-cuda.lock"))
            models.mkdir(mode=0o700, exist_ok=True)
            python = data / "venv/bin/python"
            abi = value["runtimes"]["sherpa-onnx"]["cudaWheel"]["python"]
            print("jarvis-setup: step=runtime", flush=True)
            command(["uv", "--no-config", "venv", "--managed-python", "--python", abi,
                     str(data / "venv")], data)
            if provider == "cpu":
                requirements = HERE / "requirements-local-cpu.lock"
            else:
                wheel = value["runtimes"]["sherpa-onnx"]["cudaWheel"]
                requirements = data / "requirements-cuda.lock"
                requirements.write_text((HERE / "requirements-local.lock").read_text() +
                    f"\nsherpa-onnx @ {wheel['url']} --hash=sha256:{wheel['sha256']}\n")
            command(["uv", "--no-config", "pip", "sync", "--python", str(python),
                     "--require-hashes", "--only-binary", ":all:", str(requirements)], data)
            for artifact in artifacts:
                if artifact["id"] in verified:
                    print(f"jarvis-setup: step=model id={artifact['id']} reused", flush=True)
                    continue
                print(f"jarvis-setup: step=model id={artifact['id']}", flush=True)
                target = models / Path(urlparse(artifact["url"]).path).name
                download(artifact["url"], target, artifact["sha256"], judge, data)
                if artifact["directory"] != ".":
                    extract(target, models)
            judge.verify(value, models, artifacts)
            ready = identity(judge, tier, data)
            print("jarvis-setup: step=probe", flush=True)
            # The owner reads the plain line; the engine's own lines go to the log.
            log = state / "local-setup.log"
            with log.open("w") as output, tempfile.TemporaryFile(mode="w+") as reading:
                try:
                    command(["unshare", "-rn", "--", str(python), "-I", str(HERE / "setup-local"),
                             "probe", tier], data, offline=True, stderr=output, stdout=reading)
                except ChildFailed:
                    # Only a CUDA tier has a tier that runs on any computer to fall back to.
                    advice = (" Under Local voice on the Jarvis page, choose a model that runs on any computer."
                              if provider == "cuda" else "")
                    print(f"jarvis-setup: failed=probe log={log}\n"
                          f"Local voice did not pass its test on this computer. The details are in {log}." + advice,
                          file=sys.stderr)
                    raise
                reading.seek(0)
                need = judge.memory_need(json.load(reading), tier, provider, value["tiers"][tier]["artifacts"])
            judge.verify(value, models, artifacts)
            if ready != identity(judge, tier, data):
                raise ValueError("runtime=changed-during-probe")
            ready["memory"] = need
            with tempfile.NamedTemporaryFile(mode="w", dir=state, prefix=".local-ready-", delete=False) as output:
                temporary = Path(output.name)
                try:
                    json.dump(ready, output)
                    output.flush()
                    os.fsync(output.fileno())
                    temporary.replace(marker)
                finally:
                    temporary.unlink(missing_ok=True)
        except BaseException:
            remove_runtime(data)
            kept = stored(data)
            print(f"jarvis-setup: kept={data} bytes={kept}\n"
                  f"Removed the downloaded models and runtime. Kept {size(kept)} of downloads in {data}; "
                  "the next setup reuses them.", file=sys.stderr)
            raise
        print("jarvis-setup: ready=" + tier, flush=True)


def status(judge, state, data):
    """A missing, busy, stale or unverifiable installation never reports ready."""
    report = {"tone": "warning", "text": "Not set up", "action": True}
    marker = state / "local-ready.json"
    if not state.is_dir():
        return report
    with shared(state / "local-setup.lock") as held:
        if not held:
            return {"tone": "info", "text": "Setting up", "action": False}
        if not marker.is_file():
            return report
        try:
            saved = json.loads(marker.read_text())
            tier = saved["tier"]
            value = judge.manifest(HERE / "artifacts.json")
            artifacts, _ = selected(value, tier)
            judge.validate_memory(saved["memory"], value["tiers"][tier]["provider"])
            if {key: item for key, item in saved.items() if key != "memory"} != identity(judge, tier, data):
                raise ValueError("marker=stale")
            judge.clip(value)
            judge.verify(value, data / "models", artifacts)
            return {"tone": "ok", "text": "Ready: " + tier, "action": False}
        except (ValueError, KeyError, TypeError, OSError, judge.Unavailable):
            return {"tone": "warning", "text": "Setup needs verification", "action": True}


def ready_tier(judge, state, data):
    """The tier status verifies ready, None for none; its marker names it."""
    if status(judge, state, data)["tone"] != "ok":
        return None
    return json.loads((state / "local-ready.json").read_text())["tier"]


def clone_row(value):
    """The cloned voice's artifact, which no tier holds."""
    return next(artifact for artifact in value["artifacts"] if artifact["id"] == CLONE_ID)


def clone_tier(judge, value, state, data):
    """Whether the tier status verifies ready runs on CLONE_PROVIDER, the
    graphics card the cloned voice shares."""
    tier = ready_tier(judge, state, data)
    return tier is not None and value["tiers"][tier]["provider"] == CLONE_PROVIDER


def clone_requirements(root):
    """Project requirements-local.lock beside the clone environment with its
    one onnxruntime pin replaced by requirements-clone.lock's: every other
    pin stays, and one environment holds one onnxruntime."""
    pins = [line for line in (HERE / "requirements-clone.lock").read_text().splitlines()
            if line and not line.startswith("#")]
    lines = (HERE / "requirements-local.lock").read_text().splitlines()
    replaced = [line for line in lines if line.startswith("onnxruntime==")]
    if len(pins) != 1 or len(replaced) != 1:
        raise ValueError(f"clone-lock=unprojectable pins={len(pins)} replaced={len(replaced)}")
    path = root / "requirements-clone.lock"
    path.write_text("\n".join(pins[0] if line in replaced else line for line in lines) + "\n")
    return path


def clone_identity(judge, value, data, recording):
    """Bind the clone marker to the cloned voice's selected files, its two
    locks, its installed environment and the RECORDING its probe spoke in."""
    row = clone_row(value)
    inputs = {key: row[key] for key in ("id", "baseUrl", "directory", "files")}
    locks = [
        ("requirements-local.lock", HERE / "requirements-local.lock"),
        ("requirements-clone.lock", HERE / "requirements-clone.lock"),
    ]
    return {"schemaVersion": 1, "data": str(data.resolve()), "reference": judge.sha256(recording),
            "inputs": installed(judge, inputs, locks, data / CLONE / "venv")}


def recorded(state):
    """Whether the reference is this user's regular file of mode 0600; a
    link or another owner's file is not the recording clone record wrote."""
    try:
        info = (state / REFERENCE).lstat()
    except FileNotFoundError:
        return False
    return stat.S_ISREG(info.st_mode) and stat.S_IMODE(info.st_mode) == 0o600 and info.st_uid == os.getuid()


def clone_install(judge, state, data):
    """Build the clone environment and fetch its model, beside a ready
    graphics card tier. A failure removes what this attempt made."""
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    with exclusive(state / CLONE_LOCK):
        value = judge.manifest(HERE / "artifacts.json")
        if not clone_tier(judge, value, state, data):
            raise ValueError("clone=needs-large-tier\n"
                             "The cloned voice runs beside the Large local voice model on an NVIDIA graphics card. "
                             "Set up Large under Local voice on the Jarvis page first.")
        row = clone_row(value)
        root = data / CLONE
        root.mkdir(parents=True, exist_ok=True, mode=0o700)
        # The model has no archive to hold twice; the environment and
        # uv's cache take about as much again.
        room(root, 2 * row["downloadBytes"] - stored(*(root / name for name in CLONE_RUNTIME)),
             "Free some space, then set up the cloned voice again.")
        (state / CLONE_MARKER).unlink(missing_ok=True)
        try:
            remove_runtime(root, ("venv", "requirements-clone.lock"))
            models = root / "models"
            models.mkdir(mode=0o700, exist_ok=True)
            print("jarvis-setup: step=runtime", flush=True)
            command(["uv", "--no-config", "venv", "--managed-python", "--python",
                     value["runtimes"]["sherpa-onnx"]["cudaWheel"]["python"], str(root / "venv")], data)
            command(["uv", "--no-config", "pip", "sync", "--python", str(root / "venv/bin/python"),
                     "--require-hashes", "--only-binary", ":all:", str(clone_requirements(root))], data)
            for url, path, digest in judge.downloads(row):
                target = models / path
                if target.is_file() and judge.sha256(target) == digest:
                    print(f"jarvis-setup: step=model file={path} reused", flush=True)
                    continue
                print(f"jarvis-setup: step=model file={path}", flush=True)
                target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                download(url, target, digest, judge, data)
            judge.verify(value, models, [row])
        except BaseException:
            remove_runtime(root, CLONE_RUNTIME)
            print("jarvis-setup: removed=clone\n"
                  "Removed the cloned voice's downloads and runtime.", file=sys.stderr)
            raise
    print("jarvis-setup: clone=installed", flush=True)


def clone_record(judge, state, data, source):
    """Store the raw reference SOURCE gives as a 0600 WAV, then publish the
    clone marker after its probe. A failure keeps no recording."""
    # One sample past the longest recording tells a longer one apart.
    pcm = source.read((REFERENCE_SECONDS[1] * REFERENCE_RATE + 1) * 2)
    seconds = len(pcm) / (2 * REFERENCE_RATE)
    if len(pcm) % 2 or not REFERENCE_SECONDS[0] <= seconds <= REFERENCE_SECONDS[1]:
        raise ValueError(f"recording=length seconds={seconds:.2f}\n"
                         f"The recording must last {REFERENCE_SECONDS[0]} to {REFERENCE_SECONDS[1]} seconds. "
                         "Set up the cloned voice again.")
    samples = array("h", pcm)
    if sys.byteorder != "little":
        samples.byteswap()
    if max(map(abs, samples)) < REFERENCE_PEAK:
        raise ValueError("recording=silent\n"
                         "The recording holds no sound. Check the microphone, then set up the cloned voice again.")
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    with exclusive(state / CLONE_LOCK):
        value = judge.manifest(HERE / "artifacts.json")
        marker, reference = state / CLONE_MARKER, state / REFERENCE
        (state / CLONE_MARKER).unlink(missing_ok=True)
        try:
            # mkstemp creates the file exclusively with mode 0600.
            with tempfile.NamedTemporaryFile(dir=state, prefix=".voice-reference-", delete=False) as output:
                temporary = Path(output.name)
                try:
                    with wave.open(output, "wb") as wav:
                        wav.setnchannels(1)
                        wav.setsampwidth(2)
                        wav.setframerate(REFERENCE_RATE)
                        wav.writeframes(pcm)
                    output.flush()
                    os.fsync(output.fileno())
                    temporary.replace(reference)
                finally:
                    temporary.unlink(missing_ok=True)
            ready = clone_identity(judge, value, data, reference)
            print("jarvis-setup: step=probe", flush=True)
            log = state / "clone-setup.log"
            python = data / CLONE / "venv/bin/python"
            with log.open("w") as errors, tempfile.TemporaryFile(mode="w+") as reading:
                try:
                    command(["unshare", "-rn", "--", str(python), "-I", str(HERE / "setup-local"), "clone", "probe"],
                            data, offline=True, stderr=errors, stdout=reading)
                except ChildFailed:
                    print(f"jarvis-setup: failed=clone-probe log={log}\n"
                          f"The cloned voice did not pass its test on this computer. The details are in {log}.",
                          file=sys.stderr)
                    raise
                reading.seek(0)
                need = judge.memory_need(json.load(reading), CLONE_ID, CLONE_PROVIDER, [CLONE_ID])
            judge.verify(value, data / CLONE / "models", [clone_row(value)])
            if ready != clone_identity(judge, value, data, reference):
                raise ValueError("runtime=changed-during-probe")
            ready["memory"] = need
            with tempfile.NamedTemporaryFile(mode="w", dir=state, prefix=".clone-ready-", delete=False) as output:
                temporary = Path(output.name)
                try:
                    json.dump(ready, output)
                    output.flush()
                    os.fsync(output.fileno())
                    temporary.replace(marker)
                finally:
                    temporary.unlink(missing_ok=True)
        except BaseException:
            reference.unlink(missing_ok=True)
            raise
    print("jarvis-setup: clone=ready", flush=True)


def clone_probe(judge, value, state, data):
    """Speak the bundled sentence in the recording, on the graphics card, as
    one model load of this data root; the record carries its memory need."""
    with judge.loading(data / "models"):
        judge.measure(value, [clone_row(value)], data / CLONE / "models", CLONE_PROVIDER, None, CLONE_ID,
                      state / REFERENCE)


def clone_remove(state):
    """Delete the recording and the marker. The model and its environment
    hold nothing of the user and stay for the next setup."""
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    with exclusive(state / CLONE_LOCK):
        (state / CLONE_MARKER).unlink(missing_ok=True)
        (state / REFERENCE).unlink(missing_ok=True)
    print("jarvis-setup: clone=removed", flush=True)


def clone_status(judge, state, data):
    """The cloned voice's one readiness judge. Ready only while the marker
    matches the installed identity and the recording, the model verifies, the
    recording is this user's 0600 file and the ready tier runs on the
    graphics card. `recording` and `tierReady` are for SetupGate, which
    shapes the published row: Remove while a recording exists, else Set up."""
    value = judge.manifest(HERE / "artifacts.json")
    tier = clone_tier(judge, value, state, data)
    have = recorded(state)

    def report(tone, text, offered=True):
        return {"tone": tone, "text": text, "action": ("remove" if have else "setup") if offered else False,
                "recording": have, "tierReady": tier}

    marker = state / CLONE_MARKER
    if not state.is_dir():
        return report("info", "Not set up")
    with shared(state / CLONE_LOCK) as held:
        if not held:
            return report("info", "Setting up", False)
        if not marker.is_file() or not have:
            return report("info", "Not set up")
        try:
            saved = json.loads(marker.read_text())
            judge.validate_memory(saved["memory"], CLONE_PROVIDER)
            if {key: item for key, item in saved.items() if key != "memory"} != clone_identity(
                    judge, value, data, state / REFERENCE):
                raise ValueError("marker=stale")
            judge.verify(value, data / CLONE / "models", [clone_row(value)])
        except (ValueError, KeyError, TypeError, OSError, judge.Unavailable):
            return report("warning", "Setup needs verification")
        if not tier:
            return report("warning", "Needs the Large model")
        return report("ok", "Ready")


def main():
    """Keep chosen tiers within the producer's current declaration."""
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("verb", choices=("choices", "install", "status", "probe", "clone"))
    parser.add_argument("tier", nargs="?", help="the tier; after clone, its verb")
    args = parser.parse_args()
    judge = measurement()
    state, data = roots()
    if args.verb == "clone":
        if args.tier == "install":
            clone_install(judge, state, data)
        elif args.tier == "record":
            clone_record(judge, state, data, sys.stdin.buffer)
        elif args.tier == "probe":
            clone_probe(judge, judge.manifest(HERE / "artifacts.json"), state, data)
        elif args.tier == "remove":
            clone_remove(state)
        elif args.tier == "status":
            print(json.dumps(clone_status(judge, state, data)))
        else:
            parser.error("clone takes install, record, probe, remove or status")
        return
    if args.verb in ("choices", "status") and args.tier is not None:
        parser.error(f"{args.verb} takes no tier")
    if args.verb == "choices":
        ready = ready_tier(judge, state, data)
        print(json.dumps(choices(judge.manifest(HERE / "artifacts.json"), machine(judge, data), ready)))
        return
    if args.verb == "status":
        print(json.dumps(status(judge, state, data)))
        return
    if args.verb == "probe":
        value = judge.manifest(HERE / "artifacts.json")
        probe(judge, value, args.tier, data)
    else:
        reading = machine(judge, data)
        install(judge, state, data, pick(reading) if args.tier is None else args.tier, reading)


if __name__ == "__main__":
    # A cancelled setup cannot publish its marker after the terminal closes.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    signal.signal(signal.SIGHUP, lambda *_: sys.exit(129))
    try:
        main()
    except measurement().Unavailable as error:
        print(f"jarvis-setup: unavailable={error}", file=sys.stderr)
        sys.exit(77)
    except (ValueError, KeyError, TypeError, OSError, tarfile.TarError) as error:
        print(f"jarvis-setup: failed={error}", file=sys.stderr)
        sys.exit(1)
