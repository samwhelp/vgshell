{
  "schemaVersion": 1,
  "id": "vgs.bar",
  "name": "Bar",
  "version": "0.3.0",
  "author": "VanillaGreen",
  "description": "Workspaces, clock and plugin buttons on each screen.",
  "license": "MIT",
  "icon": "panel-top",
  "kinds": [
    "bar",
    "service",
    "panel"
  ],
  "entryPoints": {
    "bar": "Bar.qml",
    "service": "Service.qml",
    "panel": "Calendar.qml"
  },
  "capabilities": [
    "builtins",
    "compositor",
    "configure",
    "ipc",
    "run",
    "requirements",
    "shortcut",
    "status",
    "surfaces"
  ],
  "requirements": [
    { "command": "gio", "packages": { "pacman": "glib2", "apt": "libglib2.0-bin", "dnf": "glib2", "nix": "glib" }, "optional": false, "purpose": "Opens a calendar day in the default browser" },
    { "command": "chromium", "packages": { "pacman": "chromium", "apt": "chromium", "nix": "chromium" }, "optional": true, "purpose": "Opens a calendar day in a Chromium profile" },
    { "command": "google-chrome-stable", "packages": { "aur": "google-chrome", "nix": "google-chrome" }, "optional": true, "purpose": "Opens a calendar day in a Google Chrome profile" },
    { "command": "brave", "packages": { "aur": "brave-bin", "nix": "brave" }, "optional": true, "purpose": "Opens a calendar day in a Brave profile" },
    { "command": "vivaldi-stable", "packages": { "pacman": "vivaldi", "nix": "vivaldi" }, "optional": true, "purpose": "Opens a calendar day in a Vivaldi profile" },
    { "command": "microsoft-edge-stable", "packages": { "aur": "microsoft-edge-stable-bin", "nix": "microsoft-edge" }, "optional": true, "purpose": "Opens a calendar day in a Microsoft Edge profile" }
  ],
  "settings": {
    "clockFormat": "ddd d MMM  HH:mm",
    "calendarUrl": "https://calendar.google.com/calendar/r/day/{year}/{month}/{day}",
    "openWith": "",
    "hidden": false
  },
  "schema": {
    "clockFormat": {
      "type": "string",
      "label": "Clock format",
      "description": "How the bar's clock shows the date and time",
      "group": "Clock",
      "format": "datetime",
      "allowCustom": true,
      "presets": [
        { "value": "ddd d MMM  HH:mm" },
        { "value": "ddd d MMM  h:mm AP" },
        { "value": "dddd HH:mm" },
        { "value": "dddd h:mm AP" },
        { "value": "HH:mm" },
        { "value": "h:mm AP" },
        { "value": "yyyy-MM-dd HH:mm" },
        { "value": "ddd d MMM" }
      ]
    },
    "calendarUrl": {
      "type": "string",
      "label": "Calendar",
      "description": "The web calendar a click on a day opens; a custom address takes {year}, {month} and {day}",
      "group": "Clock",
      "allowCustom": true,
      "presets": [
        { "value": "https://calendar.google.com/calendar/r/day/{year}/{month}/{day}", "label": "Google Calendar" },
        { "value": "https://outlook.live.com/calendar/0/view/day/{year}/{month}/{day}", "label": "Outlook" }
      ]
    },
    "openWith": {
      "type": "string",
      "label": "Open with",
      "description": "The browser and profile a click on a day opens your calendar in",
      "group": "Clock",
      "optionsFrom": "browserProfiles"
    },
    "hidden": {
      "type": "boolean",
      "label": "Hide top bar",
      "description": "Hide the bar on every screen and give its space to windows",
      "group": "Bar"
    }
  },
  "status": {
    "browserProfiles": { "type": "choices", "label": "Browser profiles", "hidden": true }
  },
  "hyprland": {
    "binds": [
      { "shortcut": "toggle", "key": "SUPER+SHIFT+SPACE", "info": "Hides the top bar, or shows it again when it is hidden." }
    ]
  },
  "menu": {
    "style.bar": { "label": "Hide top bar", "icon": "panel-top-close", "aliases": ["bar"], "shortcut": "toggle", "toggle": { "setting": "hidden", "label": "Show top bar", "icon": "panel-top-open" } }
  }
}
