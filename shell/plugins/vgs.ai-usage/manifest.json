{
  "schemaVersion": 1,
  "id": "vgs.ai-usage",
  "name": "AI Usage",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Show how much of your Claude Code, Codex and Copilot plan limits you have used.",
  "license": "MIT",
  "icon": "gauge",
  "kinds": ["service", "bar-widget", "panel"],
  "entryPoints": { "service": "Service.qml", "bar-widget": "Widget.qml", "panel": "Panel.qml" },
  "capabilities": ["ipc", "status", "surfaces", "tui", "secrets"],
  "defaultSection": "right",
  "requirements": [
    {"command": "node", "packages": {"pacman": "nodejs", "apt": "nodejs", "dnf": "nodejs", "nix": "nodejs"}, "optional": false, "purpose": "Reads the plan limits of each signed-in account"},
    {"command": "setpriv", "packages": {"pacman": "util-linux", "apt": "util-linux", "dnf": "util-linux", "nix": "util-linux"}, "optional": false, "purpose": "Stops the Codex program when a usage check ends"},
    {"command": "gum", "packages": {"pacman": "gum", "apt": "gum", "dnf": "gum", "nix": "gum"}, "optional": false, "purpose": "Draws the header of the sign-in terminal"},
    {"command": "claude", "packages": {}, "optional": true, "purpose": "Signs in to Claude Code", "setting": "showClaude"},
    {"command": "codex", "packages": {}, "optional": true, "purpose": "Signs in to Codex and reports its plan limits", "setting": "showCodex"},
    {"command": "secret-tool", "packages": {"pacman": "libsecret", "apt": "libsecret-tools", "dnf": "libsecret", "nix": "libsecret"}, "optional": true, "purpose": "Reads the Copilot sign-in from the keyring", "setting": "showCopilot"},
    {"command": "xdg-open", "packages": {"pacman": "xdg-utils", "apt": "xdg-utils", "dnf": "xdg-utils", "nix": "xdg-utils"}, "optional": true, "purpose": "Opens Vercel to create an AI Gateway key", "setting": "aiGateway"}
  ],
  "settings": { "refreshMinutes": 15, "view": "full", "sort": "provider", "barNumber": "most-used", "barShows": "used", "colourByUsage": true, "showClaude": true, "showCodex": true, "showCopilot": true, "hidden": [], "aiGateway": false },
  "schema": {
    "refreshMinutes": {"type": "number", "label": "Check interval", "description": "Time between usage checks", "min": 5, "max": 120, "step": 5, "unit": "minutes"},
    "view": {"type": "enum", "label": "View", "options": [{"value": "compact", "label": "Compact"}, {"value": "full", "label": "Full"}]},
    "sort": {"type": "string", "label": "Sort accounts", "presets": [{"value": "provider", "label": "Provider"}, {"value": "email", "label": "Email"}, {"value": "most-left", "label": "Most room first"}]},
    "barNumber": {"type": "string", "label": "Bar number", "group": "Bar", "description": "How the bar figures one number from each account's highest limit", "presets": [{"value": "average", "label": "Average"}, {"value": "most-left", "label": "Most left"}, {"value": "most-used", "label": "Most used"}]},
    "barShows": {"type": "string", "label": "Bar shows", "group": "Bar", "presets": [{"value": "used", "label": "Used"}, {"value": "left", "label": "Left"}]},
    "colourByUsage": {"type": "boolean", "label": "Colour by usage", "group": "Bar", "description": "Show the bar number in the warning colour from 80 % used"},
    "showClaude": {"type": "boolean", "label": "Claude Code", "group": "Providers"},
    "showCodex": {"type": "boolean", "label": "Codex", "group": "Providers"},
    "showCopilot": {"type": "boolean", "label": "Copilot", "group": "Providers"},
    "aiGateway": {"type": "boolean", "label": "AI Gateway credits", "group": "Providers", "description": "Show credit figures from your AI Gateway key", "info": "Select Get AI Gateway key to open Vercel. In the dashboard, open AI Gateway, then API keys, then Create key. Under [Settings](page:vgs.ai-usage/Settings), select Add key and paste the key into the masked field. The key unlocks AI Gateway credit figures."},
    "hidden": {"type": "list", "label": "Hidden accounts", "items": {"account": {"type": "string", "label": "Account", "optionsFrom": "accounts"}}, "defaults": {"account": ""}}
  },
  "tui": {
    "sign-in-claude": {"script": "tui/sign-in-claude.sh", "title": "Sign in to Claude Code", "requires": ["claude", "gum"]},
    "sign-in-codex": {"script": "tui/sign-in-codex.sh", "title": "Sign in to Codex", "requires": ["codex", "gum"]},
    "gateway-key": {"script": "tui/gateway-key.sh", "title": "Get AI Gateway key", "requires": ["xdg-open", "gum"], "entry": {"label": "Get AI Gateway key", "icon": "external-link", "group": "Sign-in", "setting": "aiGateway"}}
  },
  "status": {
    "usage": {"type": "data", "label": "Usage"},
    "accounts": {"type": "choices", "label": "Accounts", "hidden": true},
    "claude": {"type": "state", "label": "Claude Code", "group": "Sign-in", "action": {"label": "Sign in", "tui": "sign-in-claude"}, "setting": "showClaude"},
    "codex": {"type": "state", "label": "Codex", "group": "Sign-in", "action": {"label": "Sign in", "tui": "sign-in-codex"}, "setting": "showCodex"},
    "gatewayKey": {"type": "presenceList", "label": "AI Gateway key", "hint": "This key shows your AI Gateway credits", "info": "In Vercel, open AI Gateway, then API keys, then Create key. Add the key here to show AI Gateway credit figures. VGS stores the key in your keyring.", "setting": "aiGateway"}
  },
  "secrets": { "service": "vgs-ai-usage", "label": "VGS AI Usage AI Gateway key" }
}
