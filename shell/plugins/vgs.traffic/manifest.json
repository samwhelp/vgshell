{
  "schemaVersion": 1,
  "id": "vgs.traffic",
  "name": "Network Traffic",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "See network speed and traffic per app.",
  "license": "MIT",
  "icon": "arrow-down-up",
  "kinds": [
    "bar-widget",
    "panel",
    "service"
  ],
  "entryPoints": {
    "bar-widget": "Widget.qml",
    "panel": "Panel.qml",
    "service": "Service.qml"
  },
  "capabilities": [
    "status",
    "surfaces",
    "tui",
    "ipc",
    "requirements",
    "system",
    "shortcut"
  ],
  "defaultSection": "right",
  "requirements": [
    {"command": "ss", "packages": {"pacman": "iproute2", "apt": "iproute2", "dnf": "iproute", "nix": "iproute2"}, "optional": false, "purpose": "Reads TCP traffic for your apps"},
    {"command": "bandwhich", "packages": {"pacman": "bandwhich", "apt": "bandwhich", "nix": "bandwhich"}, "optional": true, "purpose": "See all shows traffic for every app and protocol", "setting": "allTraffic"},
    {"command": "readlink", "packages": {"pacman": "coreutils", "apt": "coreutils", "dnf": "coreutils", "nix": "coreutils"}, "optional": false, "purpose": "Finds physical network interfaces so traffic is counted once"},
    {"command": "getcap", "packages": {"pacman": "libcap", "apt": "libcap2-bin", "dnf": "libcap", "nix": "libcap"}, "optional": true, "purpose": "Checks whether See all has traffic capture access", "setting": "allTraffic"},
    {"command": "setcap", "packages": {"pacman": "libcap", "apt": "libcap2-bin", "dnf": "libcap", "nix": "libcap"}, "optional": true, "purpose": "Grants See all traffic its capture access", "setting": "allTraffic"},
    {"command": "kill", "packages": {"pacman": "util-linux", "apt": "procps", "dnf": "util-linux-core", "nix": "util-linux"}, "optional": false, "purpose": "Ends an app you choose to kill"}
  ],
  "settings": {
    "layout": "Stacked",
    "labelStyle": "icons",
    "refreshSeconds": 2,
    "show": "both",
    "kbDecimals": 0,
    "mbDecimals": 1
  },
  "schema": {
    "layout": {"type": "enum", "label": "Layout", "options": [{"value": "Stacked", "label": "Stacked"}, {"value": "One line", "label": "One line"}], "description": "Stacked shows two readings on two short lines", "group": "Readings"},
    "labelStyle": {"type": "enum", "label": "Labels", "options": [{"value": "icons", "label": "Icons"}, {"value": "text", "label": "Text"}], "description": "Shows an icon or a short name before each reading", "group": "Readings"},
    "refreshSeconds": {"type": "number", "label": "Refresh interval", "min": 1, "max": 10, "step": 1, "unit": "seconds", "group": "Readings"},
    "show": {"type": "enum", "label": "Speeds shown", "options": [{"value": "both", "label": "Both"}, {"value": "download", "label": "Download"}, {"value": "upload", "label": "Upload"}], "group": "Display"},
    "kbDecimals": {"type": "number", "label": "KB/s decimals", "description": "Digits after the decimal point for speeds in KB/s", "min": 0, "max": 2, "step": 1, "group": "Display"},
    "mbDecimals": {"type": "number", "label": "MB/s decimals", "description": "Digits after the decimal point for speeds in MB/s and GB/s", "min": 0, "max": 2, "step": 1, "group": "Display"},
    "allTraffic": {"type": "action", "label": "See all traffic", "description": "Let Traffic show every app and protocol", "group": "Apps"}
  },
  "status": {
    "traffic": {"type": "data", "label": "Traffic"},
    "capture": {"type": "state", "label": "Traffic capture", "hint": "See all shows every app and protocol", "info": "See all shows every app and protocol. Allowing it lets every account on this computer see network traffic through bandwhich.", "action": {"label": "Allow traffic capture", "system": "bandwhich-capture"}, "setting": "allTraffic"}
  },
  "systemSteps": [
    "bandwhich-capture"
  ],
  "tui": {
    "bandwhich": {
      "script": "tui/bandwhich.sh",
      "title": "All network traffic",
      "size": "wide",
      "requires": [
        "bandwhich"
      ]
    }
  },
  "hyprland": {
    "binds": [
      {
        "shortcut": "open",
        "key": null,
        "info": "Opens or closes the network traffic view."
      }
    ]
  },
  "menu": {
    "network-traffic": {
      "label": "Network Traffic",
      "icon": "arrow-down-up",
      "shortcut": "open"
    }
  }
}
