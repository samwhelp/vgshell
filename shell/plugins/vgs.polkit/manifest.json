{
  "schemaVersion": 1,
  "id": "vgs.polkit",
  "name": "Polkit",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Enter your password when an app needs administrator access.",
  "license": "MIT",
  "icon": "shield-check",
  "kinds": [
    "service",
    "overlay"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "overlay": "Prompt.qml"
  },
  "capabilities": [
    "polkit",
    "requirements",
    "status",
    "surfaces",
    "tui"
  ],
  "settings": {},
  "requirements": [
    { "command": "pkexec", "packages": { "pacman": "polkit", "apt": "pkexec", "dnf": "polkit", "nix": "polkit" }, "optional": true, "purpose": "Lets applications ask for administrator access" }
  ],
  "tui": {
    "uninstall": { "script": "tui/uninstall.sh", "title": "Uninstall password prompt app" },
    "stop": { "script": "tui/stop.sh", "title": "Stop password prompt app" }
  },
  "status": {
    "agent": {
      "type": "state",
      "label": "Password prompts",
      "hint": "Only one app at a time can show password prompts",
      "actions": {
        "uninstall": { "label": "Uninstall", "tui": "uninstall" },
        "stop": { "label": "Stop", "tui": "stop" }
      }
    }
  }
}
