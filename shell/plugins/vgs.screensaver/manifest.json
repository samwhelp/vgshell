{
  "schemaVersion": 1,
  "id": "vgs.screensaver",
  "name": "Screensaver",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Show animated text art when the desktop is inactive.",
  "license": "MIT",
  "icon": "monitor-play",
  "kinds": ["service", "cover"],
  "entryPoints": { "service": "Service.qml", "cover": "Cover.qml" },
  "capabilities": ["idle", "ipc", "manager", "requirements", "session", "shortcut", "status"],
  "requirements": [
    { "command": "ttfx", "packages": { "aur": "ttfx" }, "optional": false, "purpose": "Animates the screensaver text art" },
    { "command": "magick", "packages": { "pacman": "imagemagick", "dnf": "ImageMagick", "nix": "imagemagick" }, "optional": false, "purpose": "Converts an image into screensaver text art" },
    { "command": "awk", "packages": { "pacman": "gawk", "apt": "gawk", "dnf": "gawk", "nix": "gawk" }, "optional": false, "purpose": "Builds text art from converted image pixels" },
    { "command": "mv", "packages": { "pacman": "coreutils", "apt": "coreutils", "dnf": "coreutils", "nix": "coreutils" }, "optional": false, "purpose": "Moves art made before the Art setting into that setting" }
  ],
  "settings": {
    "idleEnabled": true,
    "idleSeconds": 150,
    "effect": "random",
    "art": "",
    "frameRate": 30
  },
  "schema": {
    "idleEnabled": { "type": "boolean", "label": "Start when inactive", "group": "Screensaver" },
    "idleSeconds": {
      "type": "number",
      "label": "Start after",
      "description": "This time and the lock time both count from the start of inactivity.",
      "min": 1,
      "max": 86400,
      "step": 30,
      "unit": "seconds",
      "allowCustom": true,
      "presets": [
        { "value": 60 },
        { "value": 120 },
        { "value": 150 },
        { "value": 300 },
        { "value": 600 },
        { "value": 900 },
        { "value": 1800 }
      ],
      "group": "Screensaver"
    },
    "effect": { "type": "string", "label": "Effect", "optionsFrom": "effects", "group": "Screensaver" },
    "art": {
      "type": "string",
      "label": "Art",
      "description": "A PNG or SVG image, or a text file.",
      "presets": [{ "value": "", "label": "VGS logo" }],
      "allowCustom": true,
      "group": "Screensaver"
    },
    "frameRate": {
      "type": "number",
      "label": "Frame rate",
      "min": 1,
      "max": 120,
      "step": 1,
      "allowCustom": true,
      "presets": [
        { "value": 15 },
        { "value": 30 },
        { "value": 60 },
        { "value": 120 }
      ],
      "group": "Screensaver"
    }
  },
  "status": {
    "state": { "type": "state", "label": "Screensaver" },
    "art": { "type": "state", "label": "Art" },
    "lockOrder": { "type": "state", "label": "Lock order" },
    "effects": { "type": "choices", "label": "Effects", "hidden": true }
  },
  "hyprland": {
    "binds": [
      { "shortcut": "start", "key": null, "info": "Starts the screensaver now, without waiting for the inactive time." }
    ]
  },
  "menu": {
    "system.screensaver": { "label": "Screensaver", "icon": "monitor-play", "shortcut": "start" }
  }
}
