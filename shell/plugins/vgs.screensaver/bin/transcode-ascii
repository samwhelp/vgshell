#!/usr/bin/env bash
set -euo pipefail
usage() { cat >&2 <<'USAGE'
usage: transcode-ascii <input.png|input.svg> <output> [--width N] [--height N] [--threshold N] [--invert]
USAGE
}
width=80
height=26
threshold=50
invert=false
input=""
output=""
while (($#)); do
  case "$1" in
    --width) shift; [[ $# -gt 0 && $1 =~ ^[1-9][0-9]*$ ]] || { usage; exit 2; }; width="$1" ;;
    --height) shift; [[ $# -gt 0 && $1 =~ ^[1-9][0-9]*$ ]] || { usage; exit 2; }; height="$1" ;;
    --threshold) shift; [[ $# -gt 0 && $1 =~ ^[0-9]+$ && $1 -le 100 ]] || { usage; exit 2; }; threshold="$1" ;;
    --invert) invert=true ;;
    --help|-h) usage; exit 0 ;;
    -*) usage; exit 2 ;;
    *) if [[ -z $input ]]; then input="$1"; elif [[ -z $output ]]; then output="$1"; else usage; exit 2; fi ;;
  esac
  shift
done
[[ -n $input && -n $output ]] || { usage; exit 2; }
[[ -f $input && -r $input ]] || { echo "screensaver-art: refused: input=unreadable" >&2; exit 1; }
case "${input,,}" in *.png|*.svg) ;; *) echo "screensaver-art: refused: input=type" >&2; exit 2 ;; esac
pixel_width=$((width * 2))
pixel_height=$((height * 4))
# Quickshell kills only this script when it removes the service. Each long
# child gets a parent-death signal, and the quiet form redirects stderr
# inside bash because a command substitution redirection changes the parent.
held=(setpriv --pdeathsig KILL -- bash -c '[[ $PPID == "$1" ]] || exit 1; shift; exec "$@"' held "$$")
held_quiet=(setpriv --pdeathsig KILL -- bash -c '[[ $PPID == "$1" ]] || exit 1; shift; exec "$@" 2>/dev/null' held "$$")
alpha_range="$("${held_quiet[@]}" magick -background none "$input" -alpha extract -format '%[fx:minima] %[fx:maxima]' info:)" || { echo "screensaver-art: refused: image=unreadable" >&2; exit 1; }
read -r alpha_min alpha_max <<<"$alpha_range"
use_alpha=false
if "${held[@]}" awk -v min="$alpha_min" -v max="$alpha_max" 'BEGIN { exit !(min < 0.999 && max > min) }'; then use_alpha=true; fi
magick_args=(-background none "$input" -auto-orient)
if [[ $use_alpha == true ]]; then
  magick_args+=(-alpha extract -alpha off)
  [[ $invert == true ]] && magick_args+=(-negate)
else
  magick_args+=(-alpha remove -alpha off -colorspace Gray)
  [[ $invert == false ]] && magick_args+=(-negate)
fi
magick_args+=(-bordercolor black -border 1 -trim +repage -resize "${pixel_width}x${pixel_height}" -threshold "${threshold}%" -negate -compress none pbm:-)
mkdir -p -- "$(dirname -- "$output")"
partial="$output.next"
"${held[@]}" magick "${magick_args[@]}" | "${held[@]}" awk -v cols="$width" -v rows="$height" '
function bit(x,y, idx) { idx = y * w + x + 1; return pix[idx] == "1" }
BEGIN { base = 10240; dot[0,0] = 1; dot[0,1] = 2; dot[0,2] = 4; dot[1,0] = 8; dot[1,1] = 16; dot[1,2] = 32; dot[0,3] = 64; dot[1,3] = 128 }
/^#/ { next }
NR == 1 { if ($1 != "P1") exit 3; next }
w == 0 { w = $1; h = $2; next }
{ for (i = 1; i <= NF; i++) pix[++n] = $i }
END {
  if (w == 0 || h == 0) exit 3
  out_rows = int((h + 3) / 4); out_cols = int((w + 1) / 2)
  if (out_rows > rows) out_rows = rows
  if (out_cols > cols) out_cols = cols
  for (cy = 0; cy < out_rows; cy++) {
    line = ""
    for (cx = 0; cx < out_cols; cx++) {
      v = 0
      for (dy = 0; dy < 4; dy++) for (dx = 0; dx < 2; dx++) if (bit(cx * 2 + dx, cy * 4 + dy)) v += dot[dx,dy]
      line = line sprintf("%c", base + v)
    }
    sub(/[[:space:]]+$/, "", line); print line
  }
}' >"$partial"
[[ -s $partial ]] || { echo "screensaver-art: refused: output=empty" >&2; exit 1; }
mv -f -- "$partial" "$output"
