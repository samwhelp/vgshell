{
  "schemaVersion": 1,
  "id": "vgs.devtools",
  "name": "Dev Tools",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Install and update developer tools.",
  "license": "MIT",
  "icon": "code-xml",
  "kinds": [
    "window",
    "service"
  ],
  "entryPoints": {
    "window": "Window.qml",
    "service": "Service.qml"
  },
  "capabilities": [
    "configure",
    "doctor",
    "ipc",
    "run",
    "screens",
    "shortcut",
    "status",
    "surfaces",
    "tui"
  ],
  "settings": {
    "writeLaunchers": false,
    "showInLauncher": true
  },
  "schema": {
    "showInLauncher": {
      "type": "boolean",
      "label": "Show full catalog in launcher",
      "description": "Show each Dev Tools catalog row in the launcher."
    },
    "writeLaunchers": {
      "type": "boolean",
      "label": "Add tool commands to the terminal",
      "description": "Write commands into ~/.local/bin and install a tool the first time you run one."
    }
  },
  "requirements": [
    { "command": "mise", "packages": { "pacman": "mise", "nix": "mise" }, "optional": false, "purpose": "Installs, updates and removes developer tools" }
  ],
  "status": {
    "mise": {
      "type": "state",
      "label": "Tool manager",
      "hint": "mise manages the developer tools"
    },
    "checks": {
      "type": "state",
      "label": "Checks",
      "hint": "Open Dev Tools again after 10 minutes to retry all checks."
    },
    "installed": {
      "type": "count",
      "label": "Tools installed"
    },
    "outdated": {
      "type": "count",
      "label": "Tool updates"
    },
    "missingRequirements": {
      "type": "count",
      "label": "Missing tools",
      "hint": "Install these tools from the VGS section in Dev Tools"
    },
    "catalog": {
      "type": "data",
      "label": "Catalog"
    },
    "launcherRows": {
      "type": "launcherRows",
      "label": "Launcher rows"
    }
  },
  "tui": {
    "install": {
      "script": "tui/install.sh",
      "title": "Install a developer tool",
      "entry": { "label": "Install a developer tool", "icon": "package-plus", "group": "Dev Tools" }
    },
    "update": {
      "script": "tui/update.sh",
      "title": "Update a developer tool",
      "entry": { "label": "Update a developer tool", "icon": "refresh-cw", "group": "Dev Tools" }
    },
    "remove": {
      "script": "tui/remove.sh",
      "title": "Remove a developer tool",
      "entry": { "label": "Remove a developer tool", "icon": "package-minus", "group": "Dev Tools" }
    },
    "version": { "script": "tui/devtools.sh", "title": "Choose a tool version", "size": "default", "presentation": "plain" },
    "pin": { "script": "tui/devtools.sh", "title": "Pin a developer tool", "size": "default", "presentation": "plain" },
    "unpin": { "script": "tui/devtools.sh", "title": "Unpin a developer tool", "size": "default", "presentation": "plain" },
    "rollback": { "script": "tui/devtools.sh", "title": "Roll back a developer tool", "size": "default", "presentation": "plain" },
    "update-all": { "script": "tui/devtools.sh", "title": "Update developer tools", "size": "default", "presentation": "plain" },
    "install-launch": { "script": "tui/devtools.sh", "title": "Install and launch a developer tool", "size": "default", "presentation": "plain" }
  },
  "appearance": "Appearance.js",
  "menu": {
    "devtools": { "label": "Dev Tools", "icon": "code-xml", "aliases": ["tools", "developer tools", "dev tools", "catalog"], "provider": "launcherRows", "shortcut": "launch" }
  }
}
