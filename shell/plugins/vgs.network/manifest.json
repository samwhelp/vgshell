{
  "schemaVersion": 1,
  "id": "vgs.network",
  "name": "Network",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Join Wi-Fi and see your network connections.",
  "license": "MIT",
  "icon": "wifi",
  "kinds": [
    "service",
    "bar-widget",
    "panel",
    "pane"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "bar-widget": "Widget.qml",
    "panel": "Panel.qml",
    "pane": "Pane.qml"
  },
  "capabilities": [
    "run",
    "status",
    "surfaces",
    "ipc",
    "configure",
    "requirements"
  ],
  "defaultSection": "right",
  "pane": {
    "group": "Connectivity",
    "order": 20
  },
  "requirements": [
    { "command": "xdg-open", "packages": { "pacman": "xdg-utils", "apt": "xdg-utils", "dnf": "xdg-utils", "nix": "xdg-utils" }, "optional": true, "purpose": "Opens the browser for network sign-in" },
    { "command": "nmcli", "packages": { "pacman": "networkmanager", "apt": "network-manager", "dnf": "NetworkManager", "nix": "networkmanager" }, "optional": false, "purpose": "Reads saved profiles for QR sharing, connection details and network permissions" },
    { "command": "qrencode", "packages": { "pacman": "qrencode", "apt": "qrencode", "dnf": "qrencode", "nix": "qrencode" }, "optional": false, "purpose": "Encodes a saved Wi-Fi network for sharing by QR code" },
    { "command": "systemctl", "packages": { "pacman": "systemd", "apt": "systemd", "dnf": "systemd", "nix": "systemd" }, "optional": false, "purpose": "Reads whether NetworkManager is installed and running" }
  ],
  "settings": {
    "showDisconnected": true
  },
  "status": {
    "connection": {
      "type": "state",
      "label": "Connection"
    },
    "detailsTool": {
      "type": "state",
      "label": "Connection details"
    },
    "network": {
      "type": "data",
      "label": "Network"
    }
  },
  "schema": {
    "showDisconnected": {
      "type": "boolean",
      "label": "Show disconnected icon",
      "description": "Keep the network icon in the bar while disconnected",
      "group": "Display"
    }
  }
}
