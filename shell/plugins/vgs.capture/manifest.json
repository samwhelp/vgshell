{
  "schemaVersion": 1,
  "id": "vgs.capture",
  "name": "Capture",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Save screenshots, record the screen and copy text from an area.",
  "license": "MIT",
  "icon": "camera",
  "kinds": ["service", "bar-widget", "panel", "window"],
  "entryPoints": { "service": "Service.qml", "bar-widget": "Widget.qml", "panel": "Panel.qml", "window": "Window.qml" },
  "capabilities": ["compositor", "configure", "ipc", "monitors", "notify", "requirements", "run", "screens", "screencopy", "shortcut", "status", "surfaces", "tui"],
  "defaultSection": "right",
  "requirements": [
    {"command": "systemctl", "packages": {"pacman": "systemd", "apt": "systemd", "dnf": "systemd", "nix": "systemd"}, "optional": true, "purpose": "Applies the screen sharing picker to the portal service", "setting": "screenSharing"},
    {"command": "busctl", "packages": {"pacman": "systemd", "apt": "systemd", "dnf": "systemd", "nix": "systemd"}, "optional": true, "purpose": "Checks when the screen sharing portal loaded its picker", "setting": "screenSharing"},
    {"command": "grim", "packages": {"pacman": "grim", "apt": "grim", "dnf": "grim", "nix": "grim"}, "optional": false, "purpose": "Captures screenshots and images for text recognition"},
    {"command": "slurp", "packages": {"pacman": "slurp", "apt": "slurp", "dnf": "slurp", "nix": "slurp"}, "optional": false, "purpose": "Selects an area or a whole output to capture"},
    {"command": "hyprpicker", "packages": {"pacman": "hyprpicker", "apt": "hyprpicker", "dnf": "hyprpicker", "nix": "hyprpicker"}, "optional": false, "purpose": "Holds the screen still while you select an area"},
    {"command": "wl-copy", "packages": {"pacman": "wl-clipboard", "apt": "wl-clipboard", "dnf": "wl-clipboard", "nix": "wl-clipboard"}, "optional": false, "purpose": "Copies captured images and text to the clipboard"},
    {"command": "tesseract", "packages": {"pacman": "tesseract", "apt": "tesseract-ocr", "dnf": "tesseract", "nix": "tesseract"}, "optional": false, "purpose": "Recognizes text in a captured area"},
    {"command": "gpu-screen-recorder", "packages": {"pacman": "gpu-screen-recorder", "apt": "gpu-screen-recorder-cli", "nix": "gpu-screen-recorder"}, "optional": false, "purpose": "Records an area, a window or a whole output on Arch"},
    {"command": "ffmpeg", "packages": {"pacman": "ffmpeg", "apt": "ffmpeg", "dnf": "ffmpeg-free", "nix": "ffmpeg"}, "optional": false, "purpose": "Trims and levels a finished recording and makes its thumbnail"},
    {"command": "pw-dump", "packages": {"pacman": "pipewire", "apt": "pipewire-bin", "dnf": "pipewire-utils", "nix": "pipewire"}, "optional": false, "purpose": "Lists the audio sources and cameras a recording can use, without opening them"},
    {"command": "notify-send", "packages": {"pacman": "libnotify", "apt": "libnotify-bin", "dnf": "libnotify", "nix": "libnotify"}, "optional": false, "purpose": "Shows the notification of a finished capture"},
    {"command": "gdbus", "packages": {"pacman": "glib2", "apt": "libglib2.0-bin", "dnf": "glib2", "nix": "glib"}, "optional": false, "purpose": "Closes Capture's notifications when Capture stops"},
    {"command": "imv", "packages": {"pacman": "imv", "dnf": "imv", "nix": "imv"}, "optional": true, "purpose": "Opens a saved screenshot from its notification", "setting": "viewer"},
    {"command": "satty", "packages": {"pacman": "satty", "nix": "satty"}, "optional": true, "purpose": "Edits a saved screenshot from its notification", "setting": "editor"},
    {"command": "mpv", "packages": {"pacman": "mpv", "apt": "mpv", "dnf": "mpv", "nix": "mpv"}, "optional": true, "purpose": "Plays a saved recording from its notification", "setting": "player"}
  ],
  "settings": { "folder": "", "recordFolder": "", "audio": "desktop", "smart": true, "delay": 0, "cursor": false, "processing": "save-copy",
    "quality": "very_high", "frameRate": 60, "codec": "auto", "constantFrameRate": true, "recordCursor": false, "audioSources": [], "webcam": false, "webcamDevice": "", "postProcess": true, "ocrLanguages": "eng",
    "viewer": "imv %f", "editor": "satty --filename %f --output-filename %f", "player": "mpv %f" },
  "schema": {
    "smart": {"type": "boolean", "label": "Click to select a window or display", "tooltip": "In an area capture, a click takes the window or display under it and a drag takes an area.", "group": "Screenshots"},
    "cursor": {"type": "boolean", "label": "Include pointer", "group": "Screenshots"},
    "processing": {"type": "enum", "label": "After capture", "options": [{"value": "save-copy", "label": "Save and copy"}, {"value": "copy", "label": "Copy only"}, {"value": "save", "label": "Save only"}], "group": "Screenshots"},
    "folder": {"type": "string", "label": "Screenshot folder", "description": "Empty uses Screenshots in your Pictures folder", "presets": [{"value": "", "label": "Pictures / Screenshots"}], "allowCustom": true, "group": "Folders"},
    "recordFolder": {"type": "string", "label": "Recording folder", "description": "Empty uses Screencasts in your Videos folder", "presets": [{"value": "", "label": "Videos / Screencasts"}], "allowCustom": true, "group": "Folders"},
    "audio": {"type": "enum", "label": "Audio", "options": [{"value": "none", "label": "None"}, {"value": "desktop", "label": "Desktop"}, {"value": "microphone", "label": "Microphone"}, {"value": "both", "label": "Desktop and microphone"}], "group": "Recording"},
    "quality": {"type": "enum", "label": "Quality", "options": [{"value": "medium", "label": "Medium"}, {"value": "high", "label": "High"}, {"value": "very_high", "label": "Very high"}, {"value": "ultra", "label": "Ultra"}], "group": "Recording"},
    "frameRate": {"type": "number", "label": "Frames per second", "min": 1, "max": 240, "step": 1, "group": "Recording"},
    "codec": {"type": "enum", "label": "Video codec", "options": [{"value": "auto", "label": "Auto"}, {"value": "h264", "label": "H.264"}, {"value": "hevc", "label": "HEVC"}, {"value": "av1", "label": "AV1"}, {"value": "vp9", "label": "VP9"}], "group": "Recording"},
    "constantFrameRate": {"type": "boolean", "label": "Constant frame rate", "tooltip": "Records frames at a fixed interval, even when nothing moves.", "description": "Some video editors need it", "group": "Recording"},
    "recordCursor": {"type": "boolean", "label": "Include pointer", "group": "Recording"},
    "audioSources": {"type": "list", "label": "Extra audio sources", "description": "Each source records as its own audio track", "group": "Recording", "items": {"source": {"type": "string", "label": "Source", "optionsFrom": "audioSources"}}, "defaults": {"source": ""}},
    "webcam": {"type": "boolean", "label": "Include camera", "group": "Recording"},
    "webcamDevice": {"type": "string", "label": "Camera", "optionsFrom": "cameras", "group": "Recording"},
    "postProcess": {"type": "boolean", "label": "Clean up recordings", "description": "Removes the first tenth of a second and evens out the volume", "group": "Recording"},
    "ocrLanguages": {"type": "string", "label": "Text languages", "description": "Capture reads text in the languages you choose", "group": "Text", "presets": [{"value": "eng", "label": "English"}, {"value": "deu", "label": "German"}, {"value": "fra", "label": "French"}, {"value": "spa", "label": "Spanish"}, {"value": "ita", "label": "Italian"}, {"value": "por", "label": "Portuguese"}, {"value": "nld", "label": "Dutch"}, {"value": "pol", "label": "Polish"}, {"value": "rus", "label": "Russian"}, {"value": "ukr", "label": "Ukrainian"}, {"value": "chi_sim", "label": "Chinese, simplified"}, {"value": "jpn", "label": "Japanese"}, {"value": "kor", "label": "Korean"}, {"value": "eng+deu", "label": "English and German"}, {"value": "eng+fra", "label": "English and French"}, {"value": "eng+spa", "label": "English and Spanish"}, {"value": "eng+ita", "label": "English and Italian"}, {"value": "eng+por", "label": "English and Portuguese"}, {"value": "eng+nld", "label": "English and Dutch"}, {"value": "eng+pol", "label": "English and Polish"}, {"value": "eng+rus", "label": "English and Russian"}, {"value": "eng+ukr", "label": "English and Ukrainian"}, {"value": "eng+chi_sim", "label": "English and simplified Chinese"}, {"value": "eng+jpn", "label": "English and Japanese"}, {"value": "eng+kor", "label": "English and Korean"}], "allowCustom": true},
    "viewer": {"type": "string", "label": "Image viewer", "description": "Opens a saved screenshot", "group": "Open with", "presets": [{"value": "imv %f", "label": "imv"}], "allowCustom": true},
    "editor": {"type": "string", "label": "Image editor", "description": "Edits a saved screenshot", "group": "Open with", "presets": [{"value": "satty --filename %f --output-filename %f", "label": "Satty"}], "allowCustom": true},
    "player": {"type": "string", "label": "Video player", "description": "Plays a saved recording", "group": "Open with", "presets": [{"value": "mpv %f", "label": "mpv"}], "allowCustom": true},
    "screenSharing": {"type": "action", "label": "Screen sharing", "description": "Use the VGS picker to choose what you share"}
  },
  "hyprland": { "binds": [
    { "shortcut": "screenshot", "key": "PRINT", "info": "Takes a screenshot of the screen that has focus right away." },
    { "shortcut": "screenshot-area", "key": "SUPER+SHIFT+S", "info": "Lets you drag over an area of the screen, then takes a screenshot of that area." },
    { "shortcut": "record", "key": "SUPER+SHIFT+R", "info": "Lets you drag over an area and starts recording it. Press the key again to stop the recording." },
    { "shortcut": "record-output", "key": null, "info": "Starts recording the screen that has focus. Press the key again to stop the recording." },
    { "shortcut": "toggle", "key": "SUPER+CTRL+SHIFT+S", "info": "Opens the Capture options, where you choose what to capture, or closes them." },
    { "shortcut": "text", "key": "SUPER+CTRL+PRINT", "info": "Lets you drag over an area, reads the text in it and copies that text." }
  ] },
  "status": {
    "sharing": {"type": "state", "label": "Screen sharing", "hint": "Setup applies the VGS picker. A running screen share stops.", "action": {"label": "Set up screen sharing", "tui": "setup-sharing"}, "setting": "screenSharing"},
    "capture": {"type": "data", "label": "Capture state"},
    "recording": {"type": "state", "label": "Recording"},
    "audioSources": {"type": "choices", "label": "Audio sources"},
    "cameras": {"type": "choices", "label": "Cameras"},
    "languages": {"type": "state", "label": "Text languages", "hint": "English is installed with Capture. Install languages adds the data for the other chosen text languages.", "action": {"label": "Install languages", "tui": "install-languages"}, "setting": "ocrLanguages"}
  },
  "tui": {
    "setup-sharing": { "script": "tui/setup-sharing.sh", "title": "Set up screen sharing", "requires": ["systemctl", "busctl"] },
    "install-languages": { "script": "tui/install-languages.sh", "title": "Install text languages", "requires": ["tesseract"] }
  }
}
