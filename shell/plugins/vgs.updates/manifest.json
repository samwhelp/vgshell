{
  "schemaVersion": 1,
  "id": "vgs.updates",
  "name": "Updates",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Update your system, VGS, plugins, themes and tools.",
  "license": "MIT",
  "icon": "refresh-cw",
  "kinds": ["service", "bar-widget", "window"],
  "entryPoints": { "service": "Service.qml", "bar-widget": "Widget.qml", "window": "Window.qml" },
  "capabilities": ["configure", "ipc", "screens", "shortcut", "status", "surfaces", "system", "tui"],
  "systemSteps": ["reboot-notice"],
  "defaultSection": "right",
  "requirements": [
    { "command": "checkupdates", "packages": { "pacman": "pacman-contrib" }, "optional": false, "purpose": "Checks Arch system updates" },
    { "command": "snapper", "packages": { "pacman": "snapper" }, "optional": true, "purpose": "Saves a system snapshot before updates" },
    { "command": "timeshift", "packages": { "pacman": "timeshift" }, "optional": true, "purpose": "Saves a system snapshot when Snapper is unavailable" },
    { "command": "less", "packages": { "pacman": "less", "apt": "less", "dnf": "less", "xbps": "less", "emerge": "sys-apps/less", "nix": "less" }, "optional": false, "purpose": "Shows the last update log" },
    { "command": "claude", "packages": {}, "optional": true, "purpose": "Reviews third-party packages before they install" },
    { "command": "codex", "packages": {}, "optional": true, "purpose": "Reviews third-party packages before they install" }
  ],
  "tui": {
    "update": { "script": "tui/update.sh", "title": "Update everything", "size": "tall", "entry": { "label": "Update everything", "icon": "refresh-cw", "group": "Update" } },
    "update-source": { "script": "tui/update-source.sh", "title": "Update one source", "size": "tall", "requires": [] },
    "log": { "script": "tui/log.sh", "title": "Last update log", "size": "tall", "presentation": "plain" },
    "review": { "script": "tui/review.sh", "title": "Review third-party packages", "size": "tall" }
  },
  "menu": {
    "packages": { "label": "Packages", "icon": "package" },
    "packages.install": { "label": "Install", "icon": "package", "tui": "core/pkg-install" },
    "packages.update": { "label": "Update", "icon": "refresh-cw", "tui": "vgs.updates/update" },
    "packages.remove": { "label": "Remove", "icon": "package", "aliases": ["uninstall"], "tui": "core/pkg-remove" }
  },
  "settings": {
    "intervalHours": 6,
    "hideWhenCurrent": false,
    "aurCommand": "",
    "snapshot": "auto",
    "trustPluginUpdates": false,
    "reviewThirdParty": true,
    "reviewAgent": "",
    "reviewCommand": "",
    "rebootNotice": ""
  },
  "schema": {
    "intervalHours": { "type": "number", "label": "Check interval", "description": "Time between automatic update checks", "min": 1, "max": 48, "step": 1, "unit": "hours", "group": "Schedule" },
    "hideWhenCurrent": { "type": "boolean", "label": "Hide when up to date", "description": "Hide the bar icon only when a recent check finds no updates", "group": "Display" },
    "aurCommand": {
      "type": "string",
      "label": "AUR command",
      "description": "Choose how to update Arch User Repository packages",
      "group": "Update options",
      "allowCustom": true,
      "presets": [
        { "value": "", "label": "Automatic" },
        { "value": "paru -Sua" },
        { "value": "yay -Sua" }
      ]
    },
    "snapshot": { "type": "enum", "label": "System snapshot", "description": "Save a system snapshot before updates when a snapshot tool is available", "options": ["auto", "off"], "group": "Update options" },
    "trustPluginUpdates": { "type": "boolean", "label": "Trust plugin and theme updates", "description": "Show plugin and theme changes and apply them without confirmation", "group": "Update options" },
    "reviewThirdParty": { "type": "boolean", "label": "Review third-party packages", "description": "An AI agent checks packages from outside your distribution's official repositories before they install.", "group": "Update options" },
    "reviewAgent": { "type": "string", "label": "AI agent", "description": "Choose the AI agent that checks the packages", "group": "Update options", "optionsFrom": "reviewAgents" },
    "reviewCommand": {
      "type": "string",
      "label": "Review command",
      "description": "Choose the command that starts the review agent",
      "group": "Update options",
      "allowCustom": true,
      "presets": [
        { "value": "", "label": "Automatic" },
        { "value": "claude --model opus --effort medium --permission-mode default" },
        { "value": "codex -m gpt-6.1-sol -c model_reasoning_effort=medium --sandbox workspace-write --ask-for-approval on-request" }
      ]
    },
    "rebootNotice": {
      "type": "string",
      "label": "Reboot notice",
      "description": "Choose which notice asks you to reboot after an update that needs one",
      "info": "VGS asks to reboot at the end of an update that changes the kernel or another package the CachyOS notice names, and CachyOS shows its own notice too. VGS only turns the CachyOS notice off, and CachyOS and VGS turns it back on. A change shows its commands in a terminal and asks before it runs.",
      "group": "Update options",
      "optionsFrom": "rebootNotices",
      "hideEmpty": true
    }
  },
  "hyprland": {
    "binds": [
      { "shortcut": "toggle", "key": "SUPER+CTRL+U", "info": "Opens the Updates window, or closes it." }
    ]
  },
  "status": {
    "pending": { "type": "count", "label": "Updates waiting" },
    "lastCheck": { "type": "time", "label": "Last checked" },
    "checkState": { "type": "state", "label": "Check" },
    "checking": { "type": "data", "label": "Checking" },
    "sources": { "type": "data", "label": "Sources" },
    "reviewAgents": { "type": "choices", "label": "Review agents" },
    "reviewAgent": { "type": "text", "label": "Review agent" },
    "rebootNotices": { "type": "choices", "label": "Reboot notices" },
    "rebootNotice": {
      "type": "state",
      "label": "Reboot notice",
      "hidden": true,
      "actions": {
        "vgsOnly": { "label": "Use the VGS reboot notice only", "system": "reboot-notice" },
        "both": { "label": "Turn the CachyOS notice back on", "undo": "reboot-notice" }
      }
    }
  }
}
