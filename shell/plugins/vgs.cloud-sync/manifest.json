{
  "schemaVersion": 1,
  "id": "vgs.cloud-sync",
  "name": "Cloud Sync",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Keep Google Drive folders on this computer, and send one folder to Google Drive.",
  "license": "MIT",
  "icon": "cloud-sync",
  "kinds": ["service", "bar-widget", "window"],
  "entryPoints": { "service": "Service.qml", "bar-widget": "Widget.qml", "window": "Window.qml" },
  "capabilities": ["ipc", "notify", "run", "screens", "secrets", "status", "surfaces", "tui"],
  "defaultSection": "right",
  "requirements": [
    { "command": "node", "packages": { "pacman": "nodejs", "apt": "nodejs", "dnf": "nodejs", "nix": "nodejs" }, "optional": false, "purpose": "Runs the sync and reads its status" },
    { "command": "rclone", "packages": { "pacman": "rclone", "apt": "rclone", "dnf": "rclone", "nix": "rclone" }, "optional": false, "purpose": "Copies the files to and from Google Drive" },
    { "command": "flock", "packages": { "pacman": "util-linux", "apt": "util-linux", "dnf": "util-linux", "nix": "util-linux" }, "optional": false, "purpose": "Lets only one sync of a folder pair run at a time" },
    { "command": "systemctl", "packages": { "pacman": "systemd", "apt": "systemd", "dnf": "systemd", "nix": "systemd" }, "optional": false, "purpose": "Runs the sync every hour while you are logged in" },
    { "command": "secret-tool", "packages": { "pacman": "libsecret", "apt": "libsecret-tools", "dnf": "libsecret", "nix": "libsecret" }, "optional": false, "purpose": "Reads the Google Drive keys from the keyring" },
    { "command": "notify-send", "packages": { "pacman": "libnotify", "apt": "libnotify-bin", "dnf": "libnotify", "nix": "libnotify" }, "optional": false, "purpose": "Tells you when Cloud Sync needs you" },
    { "command": "curl", "packages": { "pacman": "curl", "apt": "curl", "dnf": "curl", "nix": "curl" }, "optional": false, "purpose": "Reads the name of the Google account you sign in with" },
    { "command": "gum", "packages": { "pacman": "gum", "apt": "gum", "dnf": "gum", "nix": "gum" }, "optional": false, "purpose": "Asks the setup questions in the setup window" },
    { "command": "xdg-open", "packages": { "pacman": "xdg-utils", "apt": "xdg-utils", "dnf": "xdg-utils", "nix": "xdg-utils" }, "optional": true, "purpose": "Opens the Google sign-in page and the folders to review" }
  ],
  "tui": {
    "setup": { "script": "tui/setup.sh", "title": "Set up Cloud Sync", "requires": ["node", "systemctl"] },
    "add-pair": { "script": "tui/add-pair.sh", "title": "Add a folder pair", "requires": ["node", "gum"], "entry": { "label": "Add a folder pair", "icon": "folder-plus", "group": "Cloud Sync" } },
    "remove-pair": { "script": "tui/remove-pair.sh", "title": "Remove a folder pair", "requires": ["node", "gum"] },
    "connect-drive": { "script": "tui/connect-drive.sh", "title": "Sign in for Download", "requires": ["node", "rclone", "secret-tool", "xdg-open", "curl"] },
    "connect-upload": { "script": "tui/connect-upload.sh", "title": "Sign in for Upload", "requires": ["node", "rclone", "secret-tool", "xdg-open", "curl"] },
    "sign-out-drive": { "script": "tui/sign-out-drive.sh", "title": "Sign out of Download", "requires": ["node", "secret-tool"] },
    "sign-out-upload": { "script": "tui/sign-out-upload.sh", "title": "Sign out of Upload", "requires": ["node", "secret-tool"] }
  },
  "settings": {},
  "status": {
    "sync": {
      "type": "state",
      "label": "Cloud Sync",
      "group": "Setup",
      "info": "Cloud Sync copies the Google Drive folder of each Download folder pair to this computer, and the folder of each Upload folder pair to Google Drive. It runs every hour while you are logged in. It never deletes a file. A file you changed here, or that Google Drive removed, stays and shows in the Cloud Sync window for review."
    },
    "schedule": {
      "type": "state",
      "label": "Hourly sync",
      "group": "Setup",
      "action": { "label": "Set up hourly sync", "tui": "setup" }
    },
    "pairs": {
      "type": "state",
      "label": "Folder pairs",
      "group": "Setup",
      "actions": {
        "add": { "label": "Add a folder pair", "tui": "add-pair" },
        "remove": { "label": "Remove a folder pair", "tui": "remove-pair", "tone": "danger" }
      }
    },
    "downloadKeys": {
      "type": "presenceList",
      "label": "Keys",
      "group": "Download: Google Drive to this computer",
      "hint": "Get a client ID and secret for each direction from Google Cloud credentials.",
      "link": { "text": "Google Cloud credentials", "url": "https://console.cloud.google.com/apis/credentials" },
      "info": "In Google Cloud, create an OAuth client ID of type Desktop app for Download, and a second one for Upload. Add each client ID and secret in its group. Then select Sign in in each group. VGS stores every key in your keyring."
    },
    "download": {
      "type": "state",
      "label": "Sign-in",
      "group": "Download: Google Drive to this computer",
      "actions": {
        "signIn": { "label": "Sign in", "tui": "connect-drive" },
        "reconnect": { "label": "Sign in again", "tui": "connect-drive" },
        "signOut": { "label": "Sign out", "tui": "sign-out-drive", "tone": "danger" }
      }
    },
    "uploadKeys": {
      "type": "presenceList",
      "label": "Keys",
      "group": "Upload: this computer to Google Drive",
      "info": "Use a second OAuth client ID of type Desktop app for Upload. It reaches only the files and folders that Cloud Sync made."
    },
    "upload": {
      "type": "state",
      "label": "Sign-in",
      "group": "Upload: this computer to Google Drive",
      "actions": {
        "signIn": { "label": "Sign in", "tui": "connect-upload" },
        "reconnect": { "label": "Sign in again", "tui": "connect-upload" },
        "signOut": { "label": "Sign out", "tui": "sign-out-upload", "tone": "danger" }
      }
    },
    "lastSync": { "type": "time", "label": "Last sync" },
    "cloud": { "type": "data", "label": "Cloud Sync status" }
  },
  "secrets": { "service": "vgs-cloud-sync", "label": "VGS Cloud Sync" }
}
