{
  "schemaVersion": 1,
  "id": "vgs.cloud-sync",
  "name": "Cloud Sync",
  "version": "0.1.0",
  "author": "VanillaGreen",
  "description": "Keep Google Drive folders on this computer and in Google Drive. Cloud Sync copies both ways and never deletes a file.",
  "license": "MIT",
  "icon": "cloud-sync",
  "kinds": [
    "service",
    "bar-widget",
    "window"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "bar-widget": "Widget.qml",
    "window": "Window.qml"
  },
  "capabilities": [
    "ipc",
    "notify",
    "run",
    "screens",
    "secrets",
    "status",
    "surfaces",
    "tui"
  ],
  "defaultSection": "right",
  "requirements": [
    {
      "command": "node",
      "packages": {
        "pacman": "nodejs",
        "apt": "nodejs",
        "dnf": "nodejs",
        "nix": "nodejs"
      },
      "optional": false,
      "purpose": "Runs the sync and reads its status"
    },
    {
      "command": "rclone",
      "packages": {
        "pacman": "rclone",
        "apt": "rclone",
        "dnf": "rclone",
        "nix": "rclone"
      },
      "optional": false,
      "purpose": "Copies the files to and from Google Drive"
    },
    {
      "command": "flock",
      "packages": {
        "pacman": "util-linux",
        "apt": "util-linux",
        "dnf": "util-linux",
        "nix": "util-linux"
      },
      "optional": false,
      "purpose": "Lets only one sync of a folder pair run at a time"
    },
    {
      "command": "systemctl",
      "packages": {
        "pacman": "systemd",
        "apt": "systemd",
        "dnf": "systemd",
        "nix": "systemd"
      },
      "optional": false,
      "purpose": "Runs the sync every hour while you are logged in"
    },
    {
      "command": "secret-tool",
      "packages": {
        "pacman": "libsecret",
        "apt": "libsecret-tools",
        "dnf": "libsecret",
        "nix": "libsecret"
      },
      "optional": false,
      "purpose": "Reads the Google Drive keys from the keyring"
    },
    {
      "command": "notify-send",
      "packages": {
        "pacman": "libnotify",
        "apt": "libnotify-bin",
        "dnf": "libnotify",
        "nix": "libnotify"
      },
      "optional": false,
      "purpose": "Tells you when Cloud Sync needs you"
    },
    {
      "command": "curl",
      "packages": {
        "pacman": "curl",
        "apt": "curl",
        "dnf": "curl",
        "nix": "curl"
      },
      "optional": false,
      "purpose": "Reads the name of the Google account you sign in with"
    },
    {
      "command": "gum",
      "packages": {
        "pacman": "gum",
        "apt": "gum",
        "dnf": "gum",
        "nix": "gum"
      },
      "optional": false,
      "purpose": "Asks the setup questions in the setup window"
    },
    {
      "command": "xdg-open",
      "packages": {
        "pacman": "xdg-utils",
        "apt": "xdg-utils",
        "dnf": "xdg-utils",
        "nix": "xdg-utils"
      },
      "optional": true,
      "purpose": "Opens the Google sign-in page and the folders to review"
    }
  ],
  "tui": {
    "setup": {
      "script": "tui/setup.sh",
      "title": "Set up hourly sync",
      "requires": [
        "node",
        "systemctl"
      ]
    },
    "add-pair": {
      "script": "tui/add-pair.sh",
      "title": "Add a folder pair",
      "requires": [
        "node",
        "gum"
      ],
      "entry": {
        "label": "Add a folder pair",
        "icon": "folder-plus",
        "group": "Cloud Sync"
      }
    },
    "remove-pair": {
      "script": "tui/remove-pair.sh",
      "title": "Remove a folder pair",
      "requires": [
        "node",
        "gum"
      ]
    },
    "reset-pairs": {
      "script": "tui/reset-pairs.sh",
      "title": "Start the folder pair list again",
      "requires": [
        "node",
        "gum"
      ]
    },
    "connect-drive": {
      "script": "tui/connect-drive.sh",
      "title": "Sign in for Download",
      "requires": [
        "node",
        "rclone",
        "secret-tool",
        "xdg-open",
        "curl"
      ]
    },
    "connect-upload": {
      "script": "tui/connect-upload.sh",
      "title": "Sign in for Upload",
      "requires": [
        "node",
        "rclone",
        "secret-tool",
        "xdg-open",
        "curl"
      ]
    },
    "sign-out-drive": {
      "script": "tui/sign-out-drive.sh",
      "title": "Sign out of Download",
      "requires": [
        "node",
        "secret-tool"
      ]
    },
    "sign-out-upload": {
      "script": "tui/sign-out-upload.sh",
      "title": "Sign out of Upload",
      "requires": [
        "node",
        "secret-tool"
      ]
    }
  },
  "settings": {},
  "status": {
    "sync": {
      "type": "state",
      "label": "Cloud Sync",
      "group": "Setup",
      "info": "Cloud Sync copies each folder pair both ways. Newer files win. It never deletes a file. Older copies on this computer stay in Cloud Sync records for 30 days. Older copies on Google Drive stay in the file version history for 30 days, up to 100 versions."
    },
    "schedule": {
      "type": "state",
      "label": "Hourly sync",
      "group": "Setup",
      "action": {
        "label": "Set up hourly sync",
        "tui": "setup"
      }
    },
    "pairs": {
      "type": "state",
      "label": "Folder pairs",
      "group": "Setup",
      "actions": {
        "add": {
          "label": "Add a folder pair",
          "tui": "add-pair"
        },
        "remove": {
          "label": "Remove a folder pair",
          "tui": "remove-pair",
          "tone": "danger"
        },
        "reset": {
          "label": "Start the folder pair list again",
          "tui": "reset-pairs"
        }
      }
    },
    "downloadKeys": {
      "type": "presenceList",
      "label": "Keys",
      "group": "Download: Google Drive to this computer",
      "hint": "Get a client ID and secret for Download from Google Cloud credentials.",
      "link": {
        "text": "Google Cloud credentials",
        "url": "https://console.cloud.google.com/apis/credentials"
      },
      "info": "In Google Cloud, create an OAuth client ID of type Desktop app for Download. It reads the Google Drive folders of every pair. Add the client ID and secret, then select Sign in."
    },
    "download": {
      "type": "state",
      "label": "Sign-in",
      "group": "Download: Google Drive to this computer",
      "actions": {
        "signIn": {
          "label": "Sign in",
          "tui": "connect-drive"
        },
        "reconnect": {
          "label": "Sign in again",
          "tui": "connect-drive"
        },
        "signOut": {
          "label": "Sign out",
          "tui": "sign-out-drive",
          "tone": "danger"
        }
      }
    },
    "uploadKeys": {
      "type": "presenceList",
      "label": "Keys",
      "group": "Upload: this computer to Google Drive",
      "hint": "Get a client ID and secret for Upload from Google Cloud credentials.",
      "info": "Use a second OAuth client ID of type Desktop app for Upload. It writes only files Cloud Sync made and adds new files."
    },
    "upload": {
      "type": "state",
      "label": "Sign-in",
      "group": "Upload: this computer to Google Drive",
      "actions": {
        "signIn": {
          "label": "Sign in",
          "tui": "connect-upload"
        },
        "reconnect": {
          "label": "Sign in again",
          "tui": "connect-upload"
        },
        "signOut": {
          "label": "Sign out",
          "tui": "sign-out-upload",
          "tone": "danger"
        }
      }
    },
    "lastSync": {
      "type": "time",
      "label": "Last sync"
    },
    "cloud": {
      "type": "data",
      "label": "Cloud Sync status"
    }
  },
  "secrets": {
    "service": "vgs-cloud-sync",
    "label": "VGS Cloud Sync"
  }
}
