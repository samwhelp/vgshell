{
  "schemaVersion": 1,
  "name": "ristretto",
  "tokens": {
    "scheme": {
      "mode": "dark"
    },
    "palette": {
      "background": "#2c2525",
      "foreground": "#e6d9db",
      "accent": "#f38d70",
