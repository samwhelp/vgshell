{
  "schemaVersion": 1,
  "name": "brutalism",
  "tokens": {
    "scheme": {
      "mode": "dark"
    },
    "palette": {
      "background": "#121212",
      "foreground": "#ded3d3",
      "accent": "#c27070",
      "success": "#630a0a",
      "warning": "#cc7a7a",
      "danger": "#450404",
      "info": "#ce5757"
    },
    "color": {
      "textFaint": "mix({palette.foreground}, {palette.background}, 0.37)",
      "success": "mix({palette.success}, contrast({palette.background}), 0.48)",
      "danger": "mix({palette.danger}, contrast({palette.background}), 0.51)",
      "info": "mix({palette.info}, contrast({palette.background}), 0.13)",
      "accent": "mix({palette.accent}, contrast({palette.background}), 0.04)"
    }
  },
  "backgrounds": {
    "1-bg4.jpg": "Concrete Block",
    "2-bg3.jpg": "Red Tower",
    "3-bg2.jpg": "Concrete Banners",
    "4-bg1.jpg": "Red Circle",
    "5-bg0.jpg": "Skybridge Blocks"
  }
}
