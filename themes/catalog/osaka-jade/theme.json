{
  "schemaVersion": 1,
  "name": "osaka-jade",
  "tokens": {
    "scheme": {
      "mode": "dark"
    },
    "palette": {
      "background": "#111c18",
      "foreground": "#c1c497",
      "accent": "#5b9a7d",
      "success": "#549e6a",
      "warning": "#459451",
      "danger": "#ff5345",
      "info": "#509475"
    },
    "color": {
      "textFaint": "mix({palette.foreground}, {palette.background}, 0.27)",
      "warning": "mix({palette.warning}, contrast({palette.background}), 0.11)",
      "info": "mix({palette.info}, contrast({palette.background}), 0.08)",
      "accent": "mix({palette.accent}, contrast({palette.background}), 0.03)",
      "success": "mix({palette.success}, contrast({palette.background}), 0.02)",
      "danger": "mix({palette.danger}, contrast({palette.background}), 0.01)"
    }
  },
  "backgrounds": {
    "1-glowing-city.jpg": "Glowing City",
    "2-shaded-entrance.jpg": "Shaded Entrance",
    "3-mountain-moon.jpg": "Mountain Moon"
  }
}
