{
  "schemaVersion": 1,
  "name": "pmndrs",
  "tokens": {
    "scheme": {
      "mode": "dark"
    },
    "palette": {
      "background": "#1b1e28",
      "foreground": "#a6accd",
      "accent": "#add7ff",
      "success": "#5de4c7",
      "warning": "#fffac2",
      "danger": "#d0679d",
      "info": "#89ddff"
    },
    "color": {
      "textFaint": "mix({palette.foreground}, {palette.background}, 0.17)",
      "danger": "mix({palette.danger}, contrast({palette.background}), 0.09)",
      "textMuted": "mix({palette.foreground}, {palette.background}, 0.17)"
    }
  },
  "backgrounds": {
    "1-01-poimandres.jpg": "Striped Planets",
    "2-02-poimandres.jpg": "Night City",
    "3-03-poimandres.jpg": "Studio Desk"
  }
}
