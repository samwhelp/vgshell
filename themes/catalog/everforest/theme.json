{
  "schemaVersion": 1,
  "name": "everforest",
  "tokens": {
    "scheme": {
      "mode": "dark"
    },
    "palette": {
      "background": "#2d353b",
      "foreground": "#d3c6aa",
      "accent": "#7fbbb3",
      "success": "#a7c080",
      "warning": "#dbbc7f",
      "danger": "#e67e80",
      "info": "#7fbbb3"
    },
    "color": {
      "textMuted": "mix({palette.foreground}, {palette.background}, 0.08)",
      "textFaint": "mix({palette.foreground}, {palette.background}, 0.08)",
      "danger": "mix({palette.danger}, contrast({palette.background}), 0.19)"
    }
  },
  "backgrounds": {
    "1-tree-tops.jpg": "Forest Mist"
  }
}
