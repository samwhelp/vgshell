{
  "schemaVersion": 1,
  "name": "catppuccin-latte",
  "tokens": {
    "scheme": {
      "mode": "light"
    },
    "palette": {
      "background": "#eff1f5",
      "foreground": "#4c4f69",
      "accent": "#1b5ddf",
      "success": "#40a02b",
      "warning": "#df8e1d",
      "danger": "#d20f39",
      "info": "#1e66f5"
    },
    "color": {
      "textMuted": "mix({palette.foreground}, {palette.background}, 0.06)",
      "textFaint": "mix({palette.foreground}, {palette.background}, 0.09)",
      "success": "mix({palette.success}, contrast({palette.background}), 0.30)",
      "warning": "mix({palette.warning}, contrast({palette.background}), 0.39)",
      "danger": "mix({palette.danger}, contrast({palette.background}), 0.05)",
      "info": "mix({palette.info}, contrast({palette.background}), 0.12)",
      "accent": "mix({palette.accent}, contrast({palette.background}), 0.03)"
    }
  },
  "backgrounds": {
    "1-color-fade.png": "Color Fade"
  }
}
