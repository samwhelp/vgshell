{
  "schemaVersion": 1,
  "name": "oxford",
  "tokens": {
    "scheme": {
      "mode": "dark"
    },
    "palette": {
      "background": "#292b31",
      "foreground": "#d6d1c9",
      "accent": "#bda07f",
      "success": "#76856a",
      "warning": "#f3e9bd",
      "danger": "#dd5544",
      "info": "#bda07f"
    },
    "color": {
      "textFaint": "mix({palette.foreground}, {palette.background}, 0.20)",
      "success": "mix({palette.success}, contrast({palette.background}), 0.28)",
      "danger": "mix({palette.danger}, contrast({palette.background}), 0.31)",
      "textMuted": "mix({palette.foreground}, {palette.background}, 0.20)"
    }
  },
  "backgrounds": {
    "1-bg5.jpg": "Library Lights",
    "2-bg1.jpg": "Record Player",
    "3-bg4.jpg": "Vintage Camera",
    "4-bg2.jpg": "Vinyl Record",
    "5-bg3.jpg": "Cassette Stack"
  }
}
