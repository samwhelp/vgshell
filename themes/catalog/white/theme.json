{
  "schemaVersion": 1,
  "name": "white",
  "tokens": {
    "scheme": {
      "mode": "light"
    },
    "palette": {
      "background": "#ffffff",
      "foreground": "#000000",
      "accent": "#6b6b6b",
      "success": "#3a3a3a",
      "warning": "#4a4a4a",
      "danger": "#2a2a2a",
      "info": "#1a1a1a"
    },
    "color": {
      "textFaint": "mix({palette.foreground}, {palette.background}, 0.39)",
      "accent": "mix({palette.accent}, contrast({palette.background}), 0.05)"
    }
  },
  "backgrounds": {
    "1-white.jpg": "White Rings",
    "2-white.jpg": "White Layers",
    "3-white.jpg": "White Tiles"
  }
}
