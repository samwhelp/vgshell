{
  "schemaVersion": 1,
  "name": "nord",
  "tokens": {
    "scheme": {
      "mode": "dark"
    },
    "palette": {
      "background": "#2e3440",
      "foreground": "#d8dee9",
      "accent": "#94afca",
      "success": "#a3be8c",
      "warning": "#ebcb8b",
      "danger": "#bf616a",
      "info": "#81a1c1"
    },
    "color": {
      "textFaint": "mix({palette.foreground}, {palette.background}, 0.19)",
      "danger": "mix({palette.danger}, contrast({palette.background}), 0.41)",
      "info": "mix({palette.info}, contrast({palette.background}), 0.19)",
      "accent": "mix({palette.accent}, contrast({palette.background}), 0.05)",
      "textMuted": "mix({palette.foreground}, {palette.background}, 0.19)"
    }
  },
  "backgrounds": {
    "0-black-moon.jpg": "Black Moon",
    "1-city-view.jpg": "City Window",
    "2-night-hawks.png": "Nighthawks"
  }
}
