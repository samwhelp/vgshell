#!/usr/bin/env bash
# vgshell-dictation setup: copy core defaults when no voxtype config exists,
# offer the engine system step, then download the configured model.
set -euo pipefail
root="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd -P)"
if [[ $# != 1 || $1 != setup ]]; then
  printf 'vgs-dictation: refused: invocation=setup-required\n' >&2
  exit 2
fi
source "$root/bin/lib/tui.sh"
source "$root/bin/lib/voxtype.sh"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/voxtype"
config_file="$config_dir/config.toml"
vgs_tui_header "Set up dictation" "Existing voxtype settings stay in place."
if ! command -v voxtype >/dev/null; then
  printf 'vgs-dictation: refused: voxtype=missing\n' >&2
  vgs_tui_error "Dictation needs voxtype. Install it from the plugin's Settings page."
  exit 1
fi
if [[ ! -e $config_file && ! -L $config_file ]]; then
  vgs_tui_step "Copying dictation defaults"
  mkdir -p -- "$config_dir"
  cp -R -- "$root/config/voxtype/." "$config_dir/"
  sounds="$(cd -- "$config_dir/sounds/bloop" && pwd -P)"
  python3 - "$config_file" "$sounds" <<'PY'
import json, pathlib, sys
path = pathlib.Path(sys.argv[1])
text = path.read_text()
token = '"__VGS_DICTATION_BLOOP_THEME__"'
assert text.count(token) == 1
path.write_text(text.replace(token, json.dumps(sys.argv[2], ensure_ascii=False)))
PY
fi
engine="$(vgs_voxtype_value engine)"
model="$(vgs_voxtype_value "$engine.model")"
status=0
vgs_tui_confirm "Download and set up the $model speech model?" || status=$?
case "$status" in 0) ;; 1) exit 0 ;; *) exit "$status" ;; esac
compiled="$(vgs_voxtype_compiled "$engine")"
if [[ $compiled != yes ]]; then
  vgs_tui_step "Enabling the speech engine"
  "$root/bin/vgshell-system" apply voxtype-engine
fi
vgs_tui_step "Downloading the speech model"
voxtype setup --download --model "$model" --no-post-install
vgs_tui_success "Dictation is ready."
