#!/usr/bin/env bash
# The smoke's voxtype stand-in, for the rows that put it on the shell's
# PATH as `voxtype`; no row runs the host's command. It keeps voxtype
# 1.1.0's own contract, by file of github.com/peteonrails/voxtype at tag
# v1.1.0: one daemon per runtime directory behind `voxtype.lock`
# (src/daemon.rs:3098-3135), a `state` file the status verbs read
# (src/app/status.rs), `record start` and `record stop` as SIGUSR1 and
# SIGUSR2 after the `output_mode_override` file, `record cancel` as a
# `cancel` file (src/app/record.rs), a transcript's `.done` sidecar that
# `record stop --wait --json` reads and removes, and the cap, which drops
# the file override and types the words (src/daemon.rs:3995-4027). The
# override outlives the daemon: only an output, a cancel and the cap
# remove it, and a daemon start removes the cancel file alone
# (src/daemon.rs:3044-3046). The state file outlives a SIGKILL too: only
# a graceful end removes it (src/daemon.rs:4606), and a daemon writes its
# first word only after its model loads (src/daemon.rs:3329), which the
# stand-in holds while voxtype-loading exists. `record start` takes the
# output and submit flags (src/cli/record.rs) and writes the output one as
# the override. A recording's start consumes a cancel left from before it
# (src/daemon.rs:1140-1148).
#
# Its daemon hears the words of $control/voxtype-words, never a
# microphone, and types through the `wtype` stand-in beside this file,
# never the host's wtype. $control is the directory above this file's:
# the sandbox, for a copy in its stand-in directory. There it reads
# voxtype-words and voxtype-max-secs, the cap `config get` answers, and
# appends each thing its daemon did, one word a line, to
# voxtype-daemon.log: started, start, stop, cancel, cap, stopped, and
# refused for a second daemon; its status follower appends each state it
# prints to voxtype-follow.log. While voxtype-no-capture exists the daemon
# takes the start signal and records nothing, as one that cannot open its
# capture device (start_recording_capture, src/daemon.rs:1136), and notes
# no-capture. While voxtype-transcribing exists a stopped recording stays
# transcribing, its words undelivered, until the file is removed.
# voxtype-daemon-fail makes each child launch fail until tool repair removes
# it. voxtype-variants-unreadable makes the public inventory command fail.
#
# rows/voice.sh's copy is a stub that sets the row's own files as the
# voice_* variables and sources this file: the config and info verbs then
# answer from the row's files.
set -u
# Setup reads the shipped file through voxtype's global --config option
# before the copy is permitted. This fixture has one configured engine.
if [[ ${1:-} == --config ]]; then shift 2; fi
control="$(cd -- "$(dirname -- "$0")/.." && pwd)"
run="${XDG_RUNTIME_DIR:-$control}/voxtype"
lock="$run/voxtype.lock"
override="$run/output_mode_override"
POLL=0.05

# The lock's holder, while it is a running stand-in daemon by its command
# line, as dictation_processes of rows/capabilities.sh counts one. An ended
# daemon its parent has not reaped still takes signal 0 and has an empty
# command line, so it holds nothing, as voxtype's lock ends with its
# process.
daemon_pid() {
  local pid i
  local -a args
  pid="$(cat -- "$lock" 2>/dev/null)" && [[ $pid =~ ^[0-9]+$ ]] || return 1
  mapfile -d '' args 2>/dev/null <"/proc/$pid/cmdline" || return 1
  for i in "${!args[@]}"; do
    [[ ${args[i]##*/} == voxtype && ${args[i + 1]:-} == daemon ]] && { printf '%s\n' "$pid"; return 0; }
  done
  return 1
}
state_now() { if daemon_pid >/dev/null; then cat -- "$run/state" 2>/dev/null || echo stopped; else echo stopped; fi; }
# src/status_json.rs: text, alt, class, tooltip, then model, device, backend.
state_json() { printf '{"text": "", "alt": "%s", "class": "%s", "tooltip": "", "model": "parakeet-tdt-0.6b-v3", "device": "default", "backend": "ONNX CPU"}\n' "$1" "$1"; }
set_state() { printf '%s\n' "$1" >"$run/state.next" && mv -f -- "$run/state.next" "$run/state"; }
max_secs() { cat -- "$control/voxtype-max-secs" 2>/dev/null || echo 210; }
note() { printf '%s\n' "$1" >>"$control/voxtype-daemon.log"; }
no_daemon() { printf '%s\n' 'Error: Voxtype daemon is not running.' >&2; exit 1; }

# The recording's words go to the override's file with its sidecar, or
# through the wtype stand-in with no override; no words write nothing.
deliver() {
  local words target=""
  words="$(cat -- "$control/voxtype-words" 2>/dev/null)" || words=""
  [[ -e $override ]] && target="$(cat -- "$override")"
  rm -f -- "${override:?}"
  [[ -n $words ]] || return 0
  if [[ $target == file:* ]]; then
    printf '%s' "$words" >"${target#file:}"
    printf '{"status":"ok","chars":%s}\n' "${#words}" >"${target#file:}.done"
  else
    "$(dirname -- "$0")/wtype" -d 10 -- "$words"
  fi
}

# The daemon's signals, each taken where it arrives: bash runs a trap
# between two commands of the loop below, and at once out of its wait.
recording_since=0
on_start() {
  [[ $(cat -- "$run/state") == idle ]] || return 0
  rm -f -- "${run:?}/cancel"
  if [[ -e $control/voxtype-no-capture ]]; then
    note no-capture
    return 0
  fi
  recording_since="$(date +%s%3N)"
  set_state recording
  note start
}
on_stop() {
  [[ $(cat -- "$run/state") == recording ]] || return 0
  set_state transcribing
  note stop
  [[ -e $control/voxtype-transcribing ]] && return 0
  deliver
  set_state idle
}

run_daemon() {
  if [[ -e $control/voxtype-daemon-fail ]]; then
    printf '%s\n' 'Error: voxtype fixture cannot load its engine' >&2
    note failed
    exit 1
  fi
  mkdir -p -- "$run"
  if daemon_pid >/dev/null; then
    printf '%s\n' 'Error: Another voxtype instance is already running' >&2
    note refused
    exit 1
  fi
  rm -f -- "${run:?}/cancel"
  printf '%s\n' "$$" >"$lock"
  trap on_start USR1
  trap on_stop USR2
  trap 'rm -f -- "${run:?}/state"; note stopped; exit 0' TERM INT
  note started
  while [[ -e $control/voxtype-loading ]]; do
    sleep "$POLL" &
    wait "$!"
  done
  set_state idle
  while :; do
    if [[ $(cat -- "$run/state") == recording ]]; then
      if [[ -e $run/cancel ]]; then
        rm -f -- "${run:?}/cancel" "${override:?}"
        note cancel
        set_state idle
      elif (( $(date +%s%3N) - recording_since > $(max_secs) * 1000 )); then
        rm -f -- "${override:?}"
        set_state transcribing
        note cap
        deliver
        set_state idle
      fi
    elif [[ $(cat -- "$run/state") == transcribing && ! -e $control/voxtype-transcribing ]]; then
      deliver
      set_state idle
    fi
    sleep "$POLL" &
    wait "$!"
  done
}

# `record stop --wait --json`: the sidecar, or `empty` once the state has
# read idle for 750 ms, as src/app/record.rs:259-311 polls.
stop_wait() {
  local pid target="" idle=0 words
  pid="$(daemon_pid)" || no_daemon
  [[ -e $override ]] && target="$(cat -- "$override")"
  if [[ $target != file:* ]]; then
    printf '%s\n' 'Error: --wait needs a transcript file: start the recording with --file, set output.mode = "file", or pass --wait-file <PATH>' >&2
    exit 1
  fi
  target="${target#file:}"
  rm -f -- "${target:?}.done"
  kill -USR2 "$pid"
  while :; do
    if [[ -e $target.done ]]; then
      rm -f -- "${target:?}.done"
      words="$(cat -- "$target")"
      python3 -c 'import json,sys; print(json.dumps({"chars": len(sys.argv[1]), "message": None, "status": "ok", "text": sys.argv[1]}))' "$words"
      exit 0
    fi
    if [[ $(state_now) == idle ]]; then idle=$((idle + 1)); else idle=0; fi
    if (( idle >= 15 )); then
      printf '%s\n' '{"chars":0,"message":"the daemon returned to idle without producing a transcript","status":"empty","text":""}'
      exit 3
    fi
    sleep "$POLL"
  done
}

record_start() { # ARG...
  local pid arg
  pid="$(daemon_pid)" || no_daemon
  for arg in "$@"; do
    case "$arg" in
      --file=*) printf 'file:%s' "${arg#--file=}" >"$override" ;;
      --file) printf '%s' file >"$override" ;;
      --type) printf '%s' type >"$override" ;;
      --clipboard) printf '%s' clipboard >"$override" ;;
      --paste) printf '%s' paste >"$override" ;;
      *) ;;
    esac
  done
  kill -USR1 "$pid"
}

case "$*" in
  daemon) run_daemon ;;
  'info variants --json')
    # src/app/info.rs serializes Inventory, including its independent
    # daemon_pid (src/setup/binary.rs:839-845). A source build can have a
    # live PID and no readable running_variant.
    [[ ! -e $control/voxtype-variants-unreadable ]] || { printf '%s\n' 'Error: voxtype fixture inventory unavailable' >&2; exit 1; }
    pid="$(daemon_pid)" || pid=null
    printf '{"daemon_pid":%s,"running_variant":null}\n' "$pid"
    ;;
  'status --format json') state_json "$(state_now)" ;;
  'status --follow --extended --format json')
    last=""
    while :; do
      now="$(state_now)"
      if [[ $now != "$last" ]]; then
        state_json "$now"
        printf '%s\n' "$now" >>"$control/voxtype-follow.log"
      fi
      last="$now"
      sleep "$POLL"
    done
    ;;
  'record toggle'|'record start'|'record stop')
    if [[ $* == 'record start' ]]; then
      record_start
    else
      pid="$(daemon_pid)" || no_daemon
      if [[ $* == 'record stop' || $(state_now) == recording ]]; then kill -USR2 "$pid"; else kill -USR1 "$pid"; fi
    fi
    ;;
  'record start --'*) record_start "${@:3}" ;;
  'record stop --wait --json --timeout '*) stop_wait ;;
  'record cancel')
    daemon_pid >/dev/null || no_daemon
    : >"$run/cancel"
    ;;
  '--version') printf '%s\n' 'voxtype 1.1.0' ;;
  'config get audio.max_duration_secs') max_secs ;;
  'config get audio.device') printf '%s\n' default ;;
  'config get engine') printf '%s\n' parakeet ;;
  'config get parakeet.model') printf '%s\n' parakeet-tdt-0.6b-v3 ;;
  'config get output.mode') printf '%s\n' type ;;
  'config get output.auto_submit') printf '%s\n' false ;;
  'config get text.smart_auto_submit') printf '%s\n' false ;;
  'config get engine --json') printf '%s\n' '{"value":"parakeet"}' ;;
  'config get parakeet.model --json') printf '%s\n' '{"value":"parakeet-tdt-0.6b-v3"}' ;;
  'config get audio.feedback.enabled --json')
    [[ -e $voice_feedback_unreadable ]] && { printf '%s\n' 'Error: Configuration error: Invalid config' >&2; exit 1; }
    printf '{"file_value":%s,"key":"audio.feedback.enabled","value":%s}\n' "$(cat "$voice_feedback")" "$(cat "$voice_feedback")"
    ;;
  'config set audio.feedback.enabled true'|'config set audio.feedback.enabled false')
    printf '%s\n' "$*" >>"$voice_feedback_sets"
    [[ -e $voice_feedback_refused ]] && { printf '%s\n' 'error: config editor: write: Permission denied (os error 13)' >&2; exit 1; }
    [[ -e $voice_feedback_dropped ]] || printf '%s\n' "$4" >"$voice_feedback"
    ;;
  'info models --json')
    if [[ -e ${voice_installed:-$control/voxtype-model-installed} ]]; then installed=true; else installed=false; fi
    printf '{"engines":{"parakeet":{"models":[{"name":"parakeet-tdt-0.6b-v3","installed":%s,"downloadable":true,"download_arg":"parakeet-tdt-0.6b-v3"}],"default":"parakeet-tdt-0.6b-v3"}},"verified":true}\n' "$installed"
    ;;
  'setup --download --model parakeet-tdt-0.6b-v3 --no-post-install')
    printf '%s\n' "$*" >>"$control/voxtype-setup.log"
    touch -- "${voice_installed:-$control/voxtype-model-installed}"
    ;;
  'info engines --json')
    if [[ -e $control/voxtype-engine-missing ]]; then compiled=false; else compiled=true; fi
    printf '[{"name":"whisper","compiled":true,"active":false},{"name":"parakeet","compiled":%s,"active":true}]\n' "$compiled"
    ;;
  *) ;;
esac
