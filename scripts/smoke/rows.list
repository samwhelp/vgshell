# The nested smoke rows, one name a line, in the order scripts/qml-smoke.sh
# runs them. They share one sandbox, and a later row reads state an earlier
# one left, so the order is fixed and --rows only skips. A line that starts
# with # is a comment and a blank line is skipped; every other line is one
# row name, which names scripts/smoke/rows/<name>.sh.
#
# scripts/validate reads the added and moved lines of a change to this file
# and runs those rows, with the core rows and the rows they read:
# docs/architecture/validation.md.
bar
hyprland-consent
plugins
sources
capabilities
# After capabilities, with the first shell up and its first-start notice
# answered; it runs planted rows that each leave one class of state, and
# undoes what each left.
leak-check
session
status
manager
updates
settings
placement
windows
compositor-dispatchers
compositor-reveal
agent-warden
capability-release
surfaces
failed-builds
monitors
configuration
theme
themes
collector
theme-browse
theme-browser
portal-accent
theme-latency
notify
layers
shader-frames
tui
# With the TUI rows, through the same stand-in terminal; it enables
# vgs.sudo and gives it back disabled, its tree's sudo the sentinel again.
sudo
notices
overlays
gallery
launcher
# After launcher, whose first enable reads the edge light compiled from
# a fresh revision: this row enables the launcher to read the Dev Tools
# category, and disables it again.
devtools
# After launcher, which leaves the launcher disabled: this row enables it
# to find the web app it adds, and disables it again.
webapps
list-motion
notifications
# After notifications, whose readers and helpers it uses.
notifications-keys
automations
# After automations, whose systemctl and notify-send stand-ins it uses
# and whose unit directory it reads empty before this row writes there.
cloudsync
polkit
# The device fakes the System rows build on; they stay up after it.
device-fakes
system-steps
# After system-steps, over the same fakes' system tree.
greeter
bluetooth-agent
jarvis
jarvis-setup
jarvis-page
jarvis-input
jarvis-browser
jarvis-tasks
hyprland
hyprland-options
input-facts
# With the rows that keep the first shell and the smoke set; it enables its
# plugin itself and disables it again.
clipboard
monitor-outputs
displays-modes
hold-shortcuts
# After hold-shortcuts, over the same generated hold-bind path.
voice
jarvis-keys
jarvis-widget
jarvis-desktop
jarvis-console
instance-guard
diagnostics
supervise
# After supervise, with the tail rows that restart the shell: it proves the background launcher path and leaves a harness shell.
start
lock
# After lock, since it verifies that each plugin can run while the other is disabled.
screensaver
read-only-prefix
hyprland-consent-decline
notices-control
hidpi
start-order
overlay-capture
# After overlay-capture, which restores the harness hyprland.lua: the key
# capture rows append their own binds and restore it again.
key-capture
key-passthrough
# After overlay-capture, which restores the harness hyprland.lua this row
# appends to; it restarts the shell for its control, so it runs with the
# tail rows that do the same.
keyhints
# After keyhints, which restores the harness hyprland.lua this row appends
# to; it restarts the shell for its control, so it runs with the tail rows
# that do the same.
scratchpads
# It installs its own fixture and restarts the shell for a control, so it
# runs with the tail rows that do the same.
settings-unsaved
# This row restarts the shell for its controls, so it runs with the tail rows that do the same.
panes
# After panes, which removes its fixture holder: vgs.system holds `panes`
# here, and this row restarts the shell for a control too.
system-window
# After system-window, whose vgs.system it enables again for the Mouse pane.
mouse
# After hyprland-consent, whose wired layer it reads Hyprland through, beside
# the other System sections.
appearance
# With the System sections, whose holder its page mounts in; the player is
# the pw-play stand-in, so it needs no device fake.
sounds
keyboard
# After system-window, whose vgs.system it enables again for the displays
# pane, and after device-fakes, which leaves the XDR's report at 40 %, the
# level the row reads first.
displays
# After the System rows, with the device fakes up: Sound's pane mounts in
# the System window's holder.
sound
power
capture
share-picker
# After capture, before tui-guard: its Sign in reaches the stand-in
# terminal, and it reads no state another row leaves.
ai-usage
traffic
network
sysmon
# After system-window, which leaves vgs.system as this row finds it, and
# over the device fakes; it reads no state the displays row leaves.
bluetooth
# After system-window, which leaves vgs.system as this row finds it, and
# over the device fakes' stand-ins; it reads no state another section
# leaves.
vpn
# After launcher and hyprland, whose readers it uses; it restarts the
# shell for its controls, so it runs with the tail rows that do the same.
style
# After style, with the tail rows that restart the shell: its Restart
# relaunches the shell through the nested Hyprland, and it starts the
# sandbox's tree again before it ends.
core-drift
# After core-drift, with the tail rows that restart the shell: its Reset and
# Restore relaunch the shell through the nested Hyprland, and it starts the
# sandbox's tree again over the user file it found before it ends.
reset
# This row restarts the shell for its hidden widget and its control, so it runs with the tail rows that do the same.
widget-hide
# It restarts the shell for its pin check and a control, so it runs with the
# tail rows that do the same; its stand-in tray apps run on the sandbox's
# private bus and stop before it ends.
tray
# After every row that opens a TUI: the stand-in terminal ran no plugin
# script but a fixture's.
tui-guard
# Late, so no earlier row meets its generated plugins; it removes them
# before it ends.
plugin-pages
# Last: its reading covers every row this run held before it.
auth-sentinel
