      "ACTIVITY_START",
      "ACTIVITY_END"
     ]
    },
    "audioOffset": {
     "type": "string"
    }
   }
  },
  "SpeechConfig": {
   "type": "object",
   "properties": {
    "voiceConfig": {
     "type": "object",
     "properties": {
      "prebuiltVoiceConfig": {
       "type": "object",
       "properties": {
        "voiceName": {
         "type": "string"
        }
       },
       "required": [
        "voiceName"
       ]
      }
     }
    }
   }
  },
  "GenerationConfig": {
   "type": "object",
   "properties": {
    "responseModalities": {
     "type": "array",
     "items": {
      "type": "string",
      "enum": [
       "TEXT",
       "AUDIO"
      ]
     }
    },
    "speechConfig": {
     "$ref": "#/schemas/SpeechConfig"
    }
   }
  },
  "AudioTranscriptionConfig": {
   "type": "object",
   "properties": {}
  },
  "RealtimeInputConfig": {
   "type": "object",
   "properties": {
