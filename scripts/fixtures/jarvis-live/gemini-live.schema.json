    },
    "inlineData": {
     "$ref": "#/schemas/Blob"
    },
    "thought": {
     "type": "boolean"
    }
   }
  },
  "Content": {
   "type": "object",
   "properties": {
    "role": {
     "type": "string",
     "enum": [
      "user",
      "model"
     ]
    },
    "parts": {
     "type": "array",
     "items": {
      "$ref": "#/schemas/Part"
     }
    }
   }
  },
  "Transcription": {
   "type": "object",
   "properties": {
