     "type": "string"
    },
    "languageCode": {
     "type": "string"
    },
    "startOffset": {
     "type": "string"
    },
    "endOffset": {
     "type": "string"
    },
    "finished": {
     "type": "boolean"
    }
   }
  },
  "VoiceActivity": {
