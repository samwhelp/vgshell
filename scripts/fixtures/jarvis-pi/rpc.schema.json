{
 "source": {
  "package": "@earendil-works/pi-coding-agent@1.1.0",
  "tarball": "https://registry.npmjs.org/@earendil-works/pi-coding-agent/-/pi-coding-agent-1.1.0.tgz",
  "tarballSha256": "09cd8a0a43dbb1d81a67346b09400b439ce71d818caba4e963ea958846a1aed4",
  "path": "package/dist/modes/rpc/rpc-types.d.ts",
  "sha256": "68b6dc2e47a3969c09c961a40d0462473407b6786f3bd02715fa035e816e2af1",
  "fetched": "2026-10-08"
 },
 "rule": [
  "Each schema transcribes one TypeScript variant of RpcCommand, RpcResponse or RpcExtensionUIResponse that Jarvis writes or reads; a string literal type is a one-member enum and an optional member is left out of required.",
  "Session events are typed in json.md, not in rpc-types.d.ts; the recording beside this file holds their observed shapes.",
  "ThinkingLevel is imported from @earendil-works/pi-agent-core; its members here are the levels rpc-commands.md lists under set_thinking_level."
 ],
 "omitted": [
  "RpcCommand variants Jarvis never writes: steer, follow_up, clear_queue, new_session, cycle_model, cycle_thinking_level, set_steering_mode, set_follow_up_mode, compact, set_auto_compaction, set_auto_retry, abort_retry, bash, abort_bash, get_session_stats, export_html, switch_session, fork, clone, get_fork_messages, get_entries, get_tree, get_last_assistant_text, set_session_name, get_messages, get_commands",
  "prompt.images and prompt.streamingBehavior, which Jarvis never sends",
  "RpcExtensionUIResponse value and confirmed variants, which Jarvis never sends"
 ],
 "schemas": {
  "Command": { "oneOf": [
   { "$ref": "#/schemas/PromptCommand" }, { "$ref": "#/schemas/AbortCommand" }, { "$ref": "#/schemas/GetStateCommand" },
   { "$ref": "#/schemas/GetAvailableModelsCommand" }, { "$ref": "#/schemas/SetModelCommand" },
   { "$ref": "#/schemas/SetThinkingLevelCommand" }, { "$ref": "#/schemas/GetAvailableThinkingLevelsCommand" },
   { "$ref": "#/schemas/ExtensionUIResponse" } ] },
  "PromptCommand": { "type": "object", "required": ["id", "type", "message"],
   "properties": { "id": { "type": "string" }, "type": { "enum": ["prompt"] }, "message": { "type": "string" } } },
  "AbortCommand": { "type": "object", "required": ["id", "type"],
   "properties": { "id": { "type": "string" }, "type": { "enum": ["abort"] } } },
  "GetStateCommand": { "type": "object", "required": ["id", "type"],
   "properties": { "id": { "type": "string" }, "type": { "enum": ["get_state"] } } },
  "GetAvailableModelsCommand": { "type": "object", "required": ["id", "type"],
   "properties": { "id": { "type": "string" }, "type": { "enum": ["get_available_models"] } } },
  "SetModelCommand": { "type": "object", "required": ["id", "type", "provider", "modelId"],
   "properties": { "id": { "type": "string" }, "type": { "enum": ["set_model"] }, "provider": { "type": "string" }, "modelId": { "type": "string" } } },
  "SetThinkingLevelCommand": { "type": "object", "required": ["id", "type", "level"],
   "properties": { "id": { "type": "string" }, "type": { "enum": ["set_thinking_level"] },
    "level": { "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"] } } },
  "GetAvailableThinkingLevelsCommand": { "type": "object", "required": ["id", "type"],
   "properties": { "id": { "type": "string" }, "type": { "enum": ["get_available_thinking_levels"] } } },
  "ExtensionUIResponse": { "type": "object", "required": ["type", "id", "cancelled"],
   "properties": { "type": { "enum": ["extension_ui_response"] }, "id": { "type": "string" }, "cancelled": { "enum": [true] } } },
  "Response": { "oneOf": [
   { "type": "object", "required": ["id", "type", "command", "success"],
    "properties": { "id": { "type": "string" }, "type": { "enum": ["response"] }, "command": { "type": "string" },
     "success": { "enum": [true] }, "data": {} } },
   { "type": "object", "required": ["id", "type", "command", "success", "error"],
    "properties": { "id": { "type": "string" }, "type": { "enum": ["response"] }, "command": { "type": "string" },
     "success": { "enum": [false] }, "error": { "type": "string" } } } ] }
 }
}
