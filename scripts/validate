# The branch point, printed on stdout: the merge base of COMMIT, HEAD by
# default, with the remote-tracking copy of the project's base branch, WORKTREE_DEFAULT_BRANCH
# from the environment or from kendex.settings.toml (read by the kendex
# settings loader, so the file has one reader). Exactly one remote may carry
# that branch; none or several is missing, never a guess, so no ref that
# merely contains HEAD is taken for its base. On failure it prints what is
# missing as key=value and returns 1.
branch_point() { # [COMMIT]
  local commit="${1:-HEAD}" branch="${WORKTREE_DEFAULT_BRANCH:-}" loader="$repo/.agents/skills/orch/scripts/lib/kendex-env.sh" ref refs=()
  if [[ -z $branch && -f $repo/kendex.settings.toml ]]; then
    # shellcheck source=/dev/null
    branch="$(source "$loader" && kendex_load_settings_file "$repo/kendex.settings.toml" && printf '%s' "${WORKTREE_DEFAULT_BRANCH:-}")" || branch=""
  fi
  if [[ -z $branch ]]; then
    echo "missing=base-branch source=WORKTREE_DEFAULT_BRANCH"
    return 1
  fi
  while IFS= read -r ref; do
    [[ $ref =~ ^refs/remotes/[^/]+/(.*)$ && ${BASH_REMATCH[1]} == "$branch" ]] && refs+=("$ref")
  done < <(git for-each-ref --format='%(refname)' refs/remotes/)
  if [[ ${#refs[@]} -ne 1 ]]; then
    echo "missing=base-ref branch=$branch remote-refs=${#refs[@]}"
    return 1
  fi
  if ! git merge-base "$commit" "${refs[0]}"; then
    echo "missing=merge-base ref=${refs[0]}"
    return 1
  fi
}

# The commit the whitespace row compares against, printed on stdout, and the
# default change base: VGS_VALIDATE_BASE when set, else the branch point. On
# failure it prints what is missing as key=value and returns 1.
whitespace_base() {
  if [[ -n ${VGS_VALIDATE_BASE:-} ]]; then
    if ! git rev-parse --verify --quiet "${VGS_VALIDATE_BASE}^{commit}"; then
      echo "missing=commit VGS_VALIDATE_BASE=$VGS_VALIDATE_BASE"
      return 1
    fi
    return 0
  fi
  branch_point
}

# Whitespace errors the tree adds over the base: tracked files against the
# base commit, and every untracked file whole, since a new file has no base.
# Names are read NUL-delimited, so a name git would quote reaches git as the
# file's own name. git diff --check exits 2 for findings; with --no-index it
# exits 1 for a clean difference and 3 for findings. Any other status, or a
# clean status with output, is a read error and fails the row with git's
# message. First lines:
#   whitespace: base=<commit>
#   whitespace: findings scope=tracked | scope=untracked path=<file>
#   whitespace: unreadable scope=tracked status=<n> | scope=untracked path=<file> status=<n>
#   whitespace: failed base=<commit>
#   whitespace: status=not-measured reason=no-base <missing key=value>
whitespace_check() {
  local base file out file_status status=0
  if ! base="$(whitespace_base)"; then
    echo "whitespace: status=not-measured reason=no-base ${base##*$'\n'}"
    echo "set VGS_VALIDATE_BASE to the commit to compare against"
    return 77
  fi
  echo "whitespace: base=$base"
  file_status=0
  out="$(git diff --check "$base" -- 2>&1)" || file_status=$?
  case "$file_status" in
    0) ;;
    2) echo "whitespace: findings scope=tracked"; printf '%s\n' "$out"; status=1 ;;
    *) echo "whitespace: unreadable scope=tracked status=$file_status"; printf '%s\n' "$out"; status=1 ;;
  esac
  while IFS= read -r -d '' file; do
    file_status=0
    out="$(git diff --no-index --check -- /dev/null "$file" 2>&1)" || file_status=$?
    case "$file_status" in
      0|1) [[ -z $out ]] && continue
           echo "whitespace: unreadable scope=untracked path=$file status=$file_status" ;;
      3) echo "whitespace: findings scope=untracked path=$file" ;;
      *) echo "whitespace: unreadable scope=untracked path=$file status=$file_status" ;;
    esac
    printf '%s\n' "$out"
    status=1
  done < <(git ls-files -z --others --exclude-standard)
  [[ $status -eq 0 ]] || echo "whitespace: failed base=$base"
  return "$status"
}

# A scratch copy of the index holding the tree the change will commit, for a
# checker that reads index blobs: every tracked and untracked, non-ignored
# file matching PATHSPEC... is added as the worktree holds it, a deleted
# tracked file removed. A tracked file under an ignored directory is added
# with --force; the list names no ignored untracked file. The real index is
# never written. Prints the scratch path, which the caller removes; on
# failure prints the real index path, or `unresolved`, and returns 1.
scratch_index() { # PATHSPEC...
  local index scratch
  index="$(git rev-parse --path-format=absolute --git-path index)" || index=""
  if [[ -z $index ]] || ! scratch="$(scratch_file)"; then
    echo "${index:-unresolved}"
    return 1
  fi
  # With no index yet, git starts the scratch index empty.
  [[ -e $index ]] || rm -f -- "$scratch"
  if { [[ -e $index ]] && ! cp -- "$index" "$scratch"; } ||
     ! git ls-files -z --cached --others --exclude-standard -- "$@" |
       GIT_INDEX_FILE="$scratch" GIT_LITERAL_PATHSPECS=1 git add -A --force --pathspec-from-file=- --pathspec-file-nul; then
    rm -f -- "$scratch" "$scratch.lock"
    echo "$index"
    return 1
  fi
  echo "$scratch"
}

# The document byte ceilings of the doc-limits skill, measured on the tree
# the change will commit: doc-limits reads tracked documents and their index
# blobs, so it runs on a scratch_index of every Markdown file and docs HTML
# file. The checker judges sizes alone and reads no base. A load-point
# document over its ceiling fails the row with the checker's
# notice=document-over-limit; any other document over its ceiling passes
# with notice=document-over-budget. doc-limits exit 2, the check could not
# judge, fails the row. First lines, beside doc-limits' own output:
#   doc-limits: failed status=<n>
#   doc-limits: status=not-measured reason=checker-missing path=<file>
#   doc-limits: status=not-measured reason=index-copy-failed path=<file>
doc_limits_check() {
  local checker=".agents/skills/doc-limits/scripts/doc-limits" scratch status=0
  if [[ ! -x $checker ]]; then
    echo "doc-limits: status=not-measured reason=checker-missing path=$checker"
    return 77
  fi
  if ! scratch="$(scratch_index ':(glob)**/*.md' ':(glob)docs/**/*.html')"; then
    echo "doc-limits: status=not-measured reason=index-copy-failed path=$scratch"
    return 77
  fi
  GIT_INDEX_FILE="$scratch" "$checker" || status=$?
  rm -f -- "$scratch"
  case "$status" in
    0|1) ;;
    *) echo "doc-limits: failed status=$status"; status=1 ;;
  esac
  return "$status"
}

# The links, section routes, decision references and source citations the
# commit-guards md-refs lane judges, on the tree the change will commit.
# md-refs reads callers and targets from the index, so it runs --all on a
# scratch_index of every file. Any tracked file can carry a citation or be
# the target of one, and a removed heading breaks callers the change never
# touched, so this is a repository check and runs on every change. md-refs
# exit 2, a configuration or collection error, fails the row. First lines,
# then md-refs' own output:
#   md-refs: failed status=<n>
#   md-refs: status=not-measured reason=checker-missing path=<file>
#   md-refs: status=not-measured reason=index-copy-failed path=<file>
md_refs_check() {
  local checker=".agents/skills/commit-guards/scripts/md-refs" scratch status=0
  if [[ ! -x $checker ]]; then
    echo "md-refs: status=not-measured reason=checker-missing path=$checker"
    return 77
  fi
  if ! scratch="$(scratch_index)"; then
    echo "md-refs: status=not-measured reason=index-copy-failed path=$scratch"
    return 77
  fi
  GIT_INDEX_FILE="$scratch" "$checker" --all || status=$?
  rm -f -- "$scratch"
  case "$status" in
    0|1) ;;
    *) echo "md-refs: failed status=$status"; status=1 ;;
  esac
  return "$status"
}

# Every scripts/test-* file is named by a row, so a check cannot exist
# without running here.
rows_cover_tests() {
  local row file command word words=" " missing=() split=()
  # Every whole word of every row's command, space-delimited, so a test
  # file's path matches only a word equal to it, never a longer name that
  # starts with it.
  for row in "${rows[@]}"; do
    command="${row#*|}"
    command="${command#*|}"
    command="${command%%|*}"
    read -r -a split <<<"$command"
    for word in "${split[@]}"; do words+="$word "; done
  done
  for file in scripts/test-*; do
    [[ -e $file ]] || continue
    [[ $words == *" $file "* ]] || missing+=("$file")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    printf 'validate: refused: test-without-row=%s\n' "$(IFS=,; echo "${missing[*]}")"
    return 1
  fi
  echo "validate: every test file has a row"
}

# An install ships bin, shell, config, themes and VERSION, so no file under
# bin/ or shell/ may load one under scripts/. A load is spelled in code as a
# quoted "scripts" path component, as path.join and os.path.join take it, or
# as a scripts path segment after an expansion or a relative climb:
# $root/scripts/, ${repo}/scripts/, $(...)/scripts/, ../scripts/, and a QML
# import of "../../scripts". A bare scripts/<name>, the way a comment names a
# test, is not matched, and neither is markdown. Tracked and untracked files
# are read. git grep exits 1 both for no match and after a file it could not
# open, so anything on its stderr is a read error too. First lines, the
# refusal followed by each matching line as git grep prints it:
#   validate: refused: runtime-reads-scripts=<matching line count>
#   validate: unreadable: runtime-reads-scripts status=<n>
runtime_reads_no_scripts() {
  local pattern='(["'\'']scripts["'\'']|(\$[A-Za-z_][A-Za-z0-9_]*|[}).])/scripts([/"'\'']|$))'
  local out err err_file status=0 lines=()
  err_file="$(scratch_file)" || return 1
  out="$(git grep -n -I -E --untracked -e "$pattern" -- bin shell ':(exclude)*.md' 2>"$err_file")" || status=$?
  err="$(cat -- "$err_file")" || status=2
  rm -f -- "$err_file"
  if [[ $status -gt 1 || ( $status -eq 1 && -n $err ) ]]; then
    echo "validate: unreadable: runtime-reads-scripts status=$status"
    printf '%s\n' "$err"
    return 1
  fi
  if [[ $status -eq 0 ]]; then
    mapfile -t lines <<<"$out"
    printf 'validate: refused: runtime-reads-scripts=%s\n' "${#lines[@]}"
    printf '%s\n' "$out"
    [[ -z $err ]] || printf '%s\n' "$err"
    return 1
  fi
  echo "validate: the runtime loads nothing under scripts/"
}

# VGS writes monitor rules only through shell/Core/MonitorLogic.js, the
# renderer that judges the rule fields first. No other file an install ships
# from bin/, shell/ or config/ holds an `hl.monitor` call, spelled
# `hl.monitor` then an opening parenthesis with any blanks between them: the
# call itself, or the text a second renderer would write into a Hyprland
# config or hand `hyprctl eval`. Prose that names `hl.monitor` with no
# parenthesis is not matched, and neither is text assembled from parts, such
# as "hl." + "monitor(", which stays open. The nested test compositor's own
# configuration under scripts/smoke/ is no shipped file and is not read.
# Tracked and untracked files are read, binary files skipped. The files are
# the tree's own, listed by git under each root. A root that lists no file
# means the listing is broken, not that the root is clean, so it is refused.
# git grep exits 1 both for no match and after a file it could not open, so
# anything on its stderr is a read error too. First lines, the refusal
# followed by each matching line as git grep prints it:
#   validate: refused: monitor-rule-writer=<matching line count>
#   validate: unreadable: monitor-rule-writer status=<n>
#   validate: unreadable: monitor-rule-writer root=<root> files=0
runtime_writes_monitor_rule_once() {
  local pattern='hl\.monitor[[:space:]]*\('
  local roots=(bin shell config) root listed total=0
  local out err err_file status=0 lines=()
  for root in "${roots[@]}"; do
    if ! listed="$(git ls-files --cached --others --exclude-standard -- "$root")"; then
      echo "validate: unreadable: monitor-rule-writer status=list-failed root=$root"
      return 1
    fi
    if [[ -z $listed ]]; then
      echo "validate: unreadable: monitor-rule-writer root=$root files=0"
      return 1
    fi
    mapfile -t lines <<<"$listed"
    total=$((total + ${#lines[@]}))
  done
  err_file="$(scratch_file)" || return 1
  out="$(git grep -n -I -E --untracked -e "$pattern" -- "${roots[@]}" ':(exclude)shell/Core/MonitorLogic.js' 2>"$err_file")" || status=$?
  err="$(cat -- "$err_file")" || status=2
  rm -f -- "$err_file"
  if [[ $status -gt 1 || ( $status -eq 1 && -n $err ) ]]; then
    echo "validate: unreadable: monitor-rule-writer status=$status"
    printf '%s\n' "$err"
    return 1
  fi
  if [[ $status -eq 0 ]]; then
    mapfile -t lines <<<"$out"
    printf 'validate: refused: monitor-rule-writer=%s\n' "${#lines[@]}"
    printf '%s\n' "$out"
    [[ -z $err ]] || printf '%s\n' "$err"
    return 1
  fi
  echo "validate: monitor rule renderer is unique files=$total"
}

# No file in the tree holds a PEM private-key armor line: PRIVATE KEY with
# or without a key type such as RSA, EC or OPENSSH, and the PGP PRIVATE KEY
# BLOCK, anywhere along a line. The tree is every tracked and untracked,
# non-ignored file as it stands on disk; the index and the commits in history
# are not read. A private key has no exemption: a test that needs a key
# generates it at run time. Certificates and public keys pass. The pattern's
# own spelling below is not a header line, so this file passes. git grep exits
# 1 both for no match and after a file it could not open, so anything on its
# stderr is a read error too. First lines, the refusal followed by one
# path:line:header per match, the header alone, so a key held on one line,
# such as a JSON string, never prints its body:
#   validate: refused: private-key=<match count>
#   validate: unreadable: private-key status=<n>
private_keys_check() {
  local pattern='-----BEGIN ([[:upper:][:digit:]]+ )*PRIVATE KEY( BLOCK)?-----'
  local out err err_file status=0 lines=()
  err_file="$(scratch_file)" || return 1
  out="$(git grep -n -o -I -E --untracked -e "$pattern" -- . 2>"$err_file")" || status=$?
  err="$(cat -- "$err_file")" || status=2
  rm -f -- "$err_file"
  if [[ $status -gt 1 || ( $status -eq 1 && -n $err ) ]]; then
    echo "validate: unreadable: private-key status=$status"
    printf '%s\n' "$err"
    return 1
  fi
  if [[ $status -eq 0 ]]; then
    mapfile -t lines <<<"$out"
    printf 'validate: refused: private-key=%s\n' "${#lines[@]}"
    printf '%s\n' "$out"
    [[ -z $err ]] || printf '%s\n' "$err"
    return 1
  fi
  echo "validate: no private key in the tree"
}

# The lane bound: a diff-scoped run leaves out a row whose median in
# scripts/smoke/rows.secs exceeds this many seconds, and the batch run on
# main, which runs --full, runs it. In the measurement that file names
# (cachy, 2026-10-05) the core rows and the rows they read took 67 s
# together, auth-sentinel unmeasured, so no lane pays more for one row than
# for the whole core.
smoke_bound_secs=60

# smoke_secs_read: read scripts/smoke/rows.secs, one `<row> <seconds>` line
# per measured row after its comment lines, into smoke_secs and return 0.
# A file that cannot be read, or a line of another form, prints
# `validate: smoke-secs=unreadable` or `smoke-secs=malformed` and returns
# 1, and the caller then leaves every row in: a reading that cannot be
# trusted never narrows a run. Reads smoke_secs from smoke_rows_selected.
smoke_secs_read() {
  local file=scripts/smoke/rows.secs line number=0 lines=()
  if ! mapfile -t lines <"$file"; then
    printf 'validate: smoke-secs=unreadable path=%s\n' "$file" >&2; return 1
  fi
  for line in "${lines[@]}"; do
    number=$((number + 1))
    [[ $line == '#'* || -z $line ]] && continue
    if [[ ! $line =~ ^([a-z0-9-]+)\ (0|[1-9][0-9]*)$ ]]; then
      printf 'validate: smoke-secs=malformed line=%s path=%s\n' "$number" "$file" >&2; return 1
    fi
    smoke_secs[${BASH_REMATCH[1]}]="${BASH_REMATCH[2]}"
  done
}

# The reader of a row's input line and the core rows, smoke_core, both of
# which scripts/qml-smoke.sh shares.
source scripts/smoke/row-inputs.sh

# smoke_input_read KEY FILE: read FILE's input line into smoke_globs
# through smoke_inputs_read and return 0. A line that is missing, repeated
# or empty, or a file that cannot be read, prints its self-check line keyed
# KEY and returns 1. Each glob that matches no file of the caller's tracked
# list, matched as the rows table matches, prints its self-check line and
# sets smoke_glob_unmatched; the caller's hits caches the answer per glob.
smoke_input_read() { # KEY FILE
  local key="$1" file="$2" glob path
  smoke_glob_unmatched=false
  if ! smoke_inputs_read "$file"; then
    case "$smoke_inputs_fault" in
      unreadable) printf 'validate: smoke-input %s unreadable path=%s\n' "$key" "$file" >&2; return 1 ;;
      missing) printf 'validate: smoke-input %s missing; add to the leading comment block of %s: # inputs: GLOB [GLOB...]\n' "$key" "$file" >&2; return 1 ;;
      lines=*) printf 'validate: smoke-input %s %s; keep one line in %s: # inputs: GLOB [GLOB...]\n' "$key" "$smoke_inputs_fault" "$file" >&2; return 1 ;;
      empty) printf 'validate: smoke-input %s empty; fix the line in %s: # inputs: GLOB [GLOB...]\n' "$key" "$file" >&2; return 1 ;;
    esac
  fi
  for glob in "${smoke_globs[@]}"; do
    if [[ -z ${hits[$glob]-} ]]; then
      hits[$glob]=none
      for path in "${tracked[@]}"; do
        if [[ $path == $glob ]]; then hits[$glob]=some; break; fi
      done
    fi
    if [[ ${hits[$glob]} == none ]]; then
      printf 'validate: smoke-input %s glob=%s matches-nothing; fix the line in %s: %s\n' "$key" "$glob" "$file" "$smoke_inputs_line" >&2
      smoke_glob_unmatched=true
    fi
  done
}

# smoke_reads_check ROW...: print a self-check line for each function a
# listed row calls, or variable it reads, that neither it nor the harness
# defines but another listed row does, when the row's input line names
# none of the row files that define it: under --rows or a diff-scoped run
# the row then fails whenever the defining row is not selected. The
# definitions are those of the row files, scripts/qml-smoke.sh,
# scripts/smoke/harness.sh and the libraries it sources; a row file a row
# runs through smoke_row and no name lists counts as that row's own. A
# file the scan cannot read to its end, a quote, heredoc or substitution
# left open, prints its own line, and its names count nowhere. Reads
# lines[] and reads[] from smoke_rows_selected.
smoke_reads_check() { # ROW...
  local facts fact row kind name definers definer named
  if ! facts="$(python3 -I - "$@" <<'PY'
import pathlib, re, sys

NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
ASSIGN = re.compile(r"([A-Za-z_][A-Za-z0-9_]*)(\[[^\]]*\])?\+?=")
HEREDOC = re.compile(r"<<(-?)\s*(['\"]?)\\?([A-Za-z_][A-Za-z0-9_]*)\2")
SOURCE = re.compile(r'^\s*(?:source|\.)\s+"\$repo/([^"]+)"', re.M)
DECLARE = {"local", "declare", "typeset", "export", "readonly"}
RESET = {"if", "then", "elif", "else", "do", "while", "until", "!", "{", "time"}
TAKES = {"read": set("dinNptu"), "mapfile": set("dnOsuCc"), "readarray": set("dnOsuCc")}


def head(words):
    """The index of a command's first word that is not an assignment."""
    at = 0
    while at < len(words) - 1 and ASSIGN.match(words[at][0]):
        at += 1
    return at


def calls(scan, runs):
    """The words SCAN runs as commands: each command's first word and, while
    that word is a runner, the word at its command operand, as
    expect LABEL WANT CMD... runs CMD."""
    found = set()
    for words in scan.commands:
        at = head(words)
        while at < len(words):
            name = words[at][1]
            if name:
                found.add(name)
            if name not in runs:
                break
            at += runs[name] + 1
    return found


class Scan:
    """One bash file's functions, the names it assigns or declares, the
    variables it expands, its commands as word lists, the rows it runs
    through smoke_row, and its runners: FUNCTION -> N for each function
    whose body runs "$@" as a command after one `shift N`. Quotes, heredocs,
    comments, arithmetic and { } bodies are read as bash reads them; broken
    is set when a quote, heredoc or substitution runs to the end."""

    def __init__(self, text):
        self.t, self.n, self.broken = text, len(text), False
        self.funcs, self.sets, self.reads, self.rows = set(), set(), set(), set()
        self.commands, self.runners, self.heredocs = [], {}, []
        self.depth, self.defining, self.bodies = 0, None, []
        self.code(0, None)
        self.broken |= bool(self.heredocs)

    def dollar(self, i):
        t, j = self.t, i + 1
        if j >= self.n:
            return j
        if t[j] == "(":
            return self.arith(j + 2) if t.startswith("((", j) else self.code(j + 1, ")")
        if t[j] == "'":
            return self.single(j + 1, ansi=True)
        if t[j] == "{":
            j += 1
            if j < self.n and t[j] in "#!":
                j += 1
        m = NAME.match(t, j)
        if not m:
            return j + 1 if j < self.n and t[j] in "?$#@!*-0123456789" else j
        self.reads.add(m.group())
        return m.end()

    def single(self, i, ansi=False):
        t = self.t
        while i < self.n and t[i] != "'":
            i += 2 if ansi and t[i] == "\\" else 1
        self.broken |= i >= self.n
        return i + 1

    def arith(self, i):
        t, depth = self.t, 0
        while i < self.n:
            c = t[i]
            if c == "$":
                i = self.dollar(i)
                continue
            if c == "(":
                depth += 1
            elif c == ")":
                if depth == 0 and t.startswith("))", i):
                    return i + 2
                depth -= 1
            m = NAME.match(t, i)
            if m and not (t[i - 1].isalnum() or t[i - 1] in "_#"):
                if re.match(r"\s*(\+\+|--|[-+*/%&|^]?=(?!=))", t[m.end():]):
                    self.sets.add(m.group())
                self.reads.add(m.group())
                i = m.end()
                continue
            i += 1
        self.broken = True
        return i

    def expand(self, i, end, quote):
        """The expansions up to END, or to the closing QUOTE when set."""
        t = self.t
        while i < end:
            c = t[i]
            if c == "\\":
                i += 2
            elif quote and c == quote:
                return i + 1
            elif c == "$":
                i = self.dollar(i)
            else:
                i += 1
        self.broken |= bool(quote)
        return i

    def take_heredocs(self, i):
        t = self.t
        while self.heredocs:
            delim, quoted, strip = self.heredocs[0]
            start = i
            while i < self.n:
                end = t.find("\n", i)
                end = self.n if end < 0 else end
                line = t[i:end]
                i = end + 1
                if (line.lstrip("\t") if strip else line) == delim:
                    if not quoted:
                        self.expand(start, end - len(line), None)
                    self.heredocs.pop(0)
                    break
            else:
                return i
        return i

    def code(self, i, close):
        t = self.t
        words = []  # per word: (its unquoted literal text, that text when the word is all literal, its source text)
        cur = None
        case = 0

        def end_word():
            nonlocal cur, case
            if cur is not None:
                words.append((cur[0], cur[0] if cur[1] else None, t[cur[2]:i]))
                cur = None
                case += self.word(words)

        def end_command():
            end_word()
            if words:
                self.command(words)
            words.clear()

        def part(literal):
            nonlocal cur
            cur = cur or ["", True, i]
            if literal is None:
                cur[1] = False
            elif cur[1]:
                cur[0] += literal

        while i < self.n:
            c = t[i]
            if c == "\n":
                end_command()
                i = self.take_heredocs(i + 1)
            elif c in " \t":
                end_word()
                i += 1
            elif c == "#" and cur is None:
                j = t.find("\n", i)
                i = self.n if j < 0 else j
            elif c == "\\":
                if not t.startswith("\n", i + 1):
                    part(t[i + 1:i + 2])
                i += 2
            elif c == "'":
                part(None)
                i = self.single(i + 1)
            elif c == '"':
                part(None)
                i = self.expand(i + 1, self.n, '"')
            elif c == "$":
                part(None)
                i = self.dollar(i)
            elif t.startswith("<<", i) and not t.startswith("<<<", i):
                end_word()
                m = HEREDOC.match(t, i)
                if m:
                    self.heredocs.append((m.group(3), bool(m.group(2)), bool(m.group(1))))
                i = m.end() if m else i + 2
            elif c in "<>" and t.startswith("(", i + 1):
                end_word()
                i = self.code(i + 2, ")")
            elif c == "(":
                if cur is not None and cur[1] and cur[0] and t.startswith(")", i + 1):
                    self.funcs.add(cur[0])
                    self.defining = cur[0]
                    cur = None
                    words.clear()
                    i += 2
                elif cur is not None and cur[1] and cur[0].endswith("="):
                    end_word()  # name=( WORDS ): the words are values
                    i = self.code(i + 1, ")")
                elif cur is None and t.startswith("((", i):
                    i = self.arith(i + 2)
                else:
                    end_command()
                    i = self.code(i + 1, ")")
            elif c == ")":
                end_command()
                i += 1
                if close == ")" and not case:
                    return i
            elif c in ";|&":
                end_command()
                i += 1
            elif c in "<>":
                end_word()
                i += 1
            else:
                part(c)
                i += 1
        end_command()
        self.broken |= close is not None
        return i

    def word(self, words):
        """Read the word that just ended; return the change in case depth."""
        prefix, whole, _ = words[-1]
        pos, at = len(words) - 1, head(words)
        if pos == at:
            if whole != "{":
                self.defining = None
            m = ASSIGN.match(prefix)
            if m:
                self.sets.add(m.group(1))
            elif whole == "{":
                self.depth += 1
                if self.defining:
                    self.bodies.append((self.defining, self.depth, []))
                    self.defining = None
                words.clear()
            elif whole == "}":
                if self.bodies and self.bodies[-1][1] == self.depth:
                    name, _, shifts = self.bodies.pop()
                    if shifts and shifts[-1] == "runs" and len(shifts) <= 2 and None not in shifts:
                        self.runners[name] = shifts[0] if len(shifts) == 2 else 0
                self.depth -= 1
            elif whole in RESET:
                words.clear()
            return {"case": 1, "esac": -1}.get(whole, 0)
        cmd, args = words[at][1], [w[1] for w in words[at + 1:]]
        prev = args[-2] if len(args) > 1 else None
        if cmd == "smoke_row" and len(args) == 1 and whole:
            self.rows.add(whole)
        elif cmd == "function" and len(args) == 1 and whole:
            self.funcs.add(whole)
        elif cmd in DECLARE:
            m = NAME.match(prefix)
            if m and not prefix.startswith("-"):
                self.sets.add(m.group())
        elif cmd in ("for", "select") and len(args) == 1 and whole:
            self.sets.add(whole)
        elif cmd == "printf" and prev == "-v" and whole:
            self.sets.add(whole)
        elif cmd == "getopts" and len(args) == 2 and whole:
            self.sets.add(whole)
        elif cmd in TAKES and whole and NAME.fullmatch(whole):
            if not (prev and prev.startswith("-") and prev[-1] in TAKES[cmd]):
                self.sets.add(whole)
        return 0

    def command(self, words):
        """Keep a command's words, and note in the innermost open function
        body each shift and the "$@" it runs: a body runs its arguments when
        it holds at most one literal shift and then runs "$@"."""
        self.commands.append(list(words))
        if not self.bodies or self.bodies[-1][2][-1:] == ["runs"]:
            return
        at, shifts = head(words), self.bodies[-1][2]
        if words[at][1] == "shift":
            count = words[at + 1][1] if at + 1 < len(words) else "1"
            shifts.append(int(count) if count and count.isdigit() else None)
        elif words[at][2] == '"$@"':
            shifts.append("runs")


def read(rel):
    try:
        return pathlib.Path(rel).read_text()
    except (OSError, UnicodeDecodeError):
        return None


listed = sys.argv[1:]
texts, side, queue = {}, [], ["scripts/qml-smoke.sh", "scripts/smoke/harness.sh"]
while queue:
    rel = queue.pop(0)
    if rel not in texts:
        texts[rel] = read(rel)
        side.append(rel)
        queue += SOURCE.findall(texts[rel] or "")
for path in sorted(pathlib.Path("scripts/smoke/rows").glob("*.sh")):
    texts.setdefault(str(path), read(path))
scans = {}
for rel, text in texts.items():
    if text is None or (scan := Scan(text)).broken:
        print("unparsed", rel)
    else:
        scans[rel] = scan
runs = {}
for scan in scans.values():
    runs.update(scan.runners)
for scan in scans.values():
    scan.calls = calls(scan, runs)
side_owned = {field: set().union(*(scans[rel].__dict__[field] for rel in side if rel in scans)) for field in ("funcs", "sets")}
owned = {}
for row in listed:
    parts, queue = [], [f"scripts/smoke/rows/{row}.sh"]
    while queue:
        rel = queue.pop(0)
        if rel in scans and scans[rel] not in parts:
            parts.append(scans[rel])
            queue += [f"scripts/smoke/rows/{child}.sh" for child in scans[rel].rows if child not in listed]
    owned[row] = {field: set().union(*(s.__dict__[field] for s in parts)) for field in ("funcs", "sets", "calls", "reads")}
for row in listed:
    for kind, used, field in (("function", "calls", "funcs"), ("variable", "reads", "sets")):
        for name in sorted(owned[row][used] - owned[row][field] - side_owned[field]):
            definers = [other for other in listed if other != row and name in owned[other][field]]
            if definers:
                print("read", row, kind, name, ",".join(definers))
PY
)"; then
    echo 'validate: smoke-input reads=unreadable; the function and variable check did not run' >&2; return 0
  fi
  while read -r fact row kind name definers; do
    case "$fact" in
      '') continue ;;
      unparsed) printf 'validate: smoke-input unparsed path=%s; the function and variable check cannot read it to its end\n' "$row" >&2; continue ;;
      read) ;;
      *) printf 'validate: smoke-input reads=unreadable fact=%q\n' "$fact" >&2; return 0 ;;
    esac
    named=false
    for definer in ${definers//,/ }; do
      [[ " ${reads[$row]-} " != *" $definer "* ]] || named=true
    done
    [[ $named == false ]] || continue
    printf 'validate: smoke-input row=%s %s=%s from=scripts/smoke/rows/%s.sh; add to the line in scripts/smoke/rows/%s.sh: # inputs: %s scripts/smoke/rows/%s.sh\n' \
      "$row" "$kind" "$name" "${definers//,/.sh,scripts/smoke/rows/}" "$row" "${lines[$row]-}" "${definers%%,*}" >&2
  done <<<"$facts"
}

# smoke_list_rows: mark in want[] and edited[] each row an added line of
# the row list names, against the change base; a line git shows as added is a new or a
# moved row. A removed line whose name the list no longer holds is an
# unlisted row: its name joins unlisted[], and the caller runs each row
# whose input line names that row's file, since that row reads state the
# unlisted row no longer leaves. A list the diff cannot read, or one git
# does not track, whose lines no diff shows, sets every instead. Reads
# names[], tracked[] and smoke_list from smoke_rows_selected.
smoke_list_rows() {
  local diff line sign hunk=false
  if [[ " ${tracked[*]} " != *" $smoke_list "* ]]; then
    printf -v every 'reason=rows-list-untracked path=%q' "$smoke_list"; return 0
  fi
  if ! diff="$(git diff -U0 --no-color --no-ext-diff "$change_base" -- "$smoke_list")"; then
    printf -v every 'reason=rows-list-diff-unreadable path=%q' "$smoke_list"; return 0
  fi
  while IFS= read -r line; do
    if [[ $line == @@* ]]; then hunk=true; continue; fi
    [[ $hunk == true && ( $line == +* || $line == -* ) ]] || continue
    sign="${line:0:1}"; line="${line:1}"
    [[ -z $line || $line == '#'* ]] && continue
    if [[ $sign == - ]]; then
      [[ " ${names[*]} " == *" $line "* ]] || unlisted+=("$line")
      continue
    fi
    if [[ " ${names[*]} " != *" $line "* ]]; then
      printf -v every 'reason=rows-list-unlisted-line value=%q' "$line"; return 0
    fi
    want[$line]=1
    edited[$line]=1
  done <<<"$diff"
}

# The nested smoke rows a diff-scoped run passes to scripts/qml-smoke.sh as
# --rows, set in smoke_only comma-joined, or empty for every row.
# `scripts/qml-smoke.sh --list-rows` names the rows. Each row's file,
# scripts/smoke/rows/<row>.sh, carries an input line smoke_input_read
# reads; its globs and the file itself are its inputs. A row runs when a
# changed path matches an input, when it is a core row, or when a running
# row names its file exactly as an input: that row reads the other's
# functions or state and fails without it. A row whose line cannot be read
# or holds a glob that matches no tracked file runs on every change.
# scripts/smoke/harness.sh carries an input line too, naming what the
# harness and the libraries it sources read for every row. The harness
# inputs are scripts/qml-smoke.sh, which holds the latency budgets and the
# commands the sandbox hides, scripts/smoke/row-inputs.sh, which holds
# the core rows and reads the rows a row brings, harness.sh and the paths
# its line matches: a change to one runs every row, as does a harness
# line, row list or tracked-file list this cannot read; a harness glob
# that matches nothing only reports. scripts/smoke/rows.list, which holds the row order, is no
# harness input: a change to it runs the rows its added lines name, read
# from the diff against the change base, so a moved row runs and a comment
# runs nothing, and a row its removed lines unlist brings each row that
# names its file. A row over smoke_bound_secs leaves a selection of some
# rows, printed as `validate: smoke-row skipped=over-bound row=<row>`,
# unless it is a core row, the change edits its own file, a row file its
# line names or its row list line, or a selected row reads it; --full,
# which passes no --rows, runs it. The self-check lines
# smoke_input_read prints never change the exit status.
smoke_rows_selected() { # CHANGED_PATH...
  local listed row file path glob needed count secs every="" smoke_list=scripts/smoke/rows.list
  local -a names tracked smoke_globs smoke_inputs_named unlisted=() over=() skipped=()
  local -A want=() reads=() hits=() lines=() smoke_secs=() edited=()
  local smoke_glob_unmatched smoke_inputs_line smoke_inputs_fault
  smoke_only=""
  if ! listed="$(scripts/qml-smoke.sh --list-rows)" || [[ -z $listed ]]; then
    echo 'validate: smoke-rows=all reason=row-list-unreadable' >&2; return 0
  fi
  mapfile -t names <<<"$listed"
  for row in "${smoke_core[@]}"; do
    if [[ " ${names[*]} " != *" $row "* ]]; then
      printf 'validate: smoke-rows=all reason=core-row-missing row=%s\n' "$row" >&2; return 0
    fi
    want[$row]=1
  done
  if ! mapfile -d '' -t tracked < <(git ls-files -z) || ! wait "$!" || [[ ${#tracked[@]} -eq 0 ]]; then
    echo 'validate: smoke-rows=all reason=tracked-list-unreadable' >&2; return 0
  fi
  if ! smoke_input_read harness=scripts/smoke/harness.sh scripts/smoke/harness.sh; then
    every='reason=harness-line-unreadable'
  fi
  for path in "$@"; do
    [[ -z $every ]] || break
    for glob in scripts/qml-smoke.sh scripts/smoke/row-inputs.sh scripts/smoke/harness.sh "${smoke_globs[@]}"; do
      if [[ $path == $glob ]]; then printf -v every 'reason=harness-input path=%q' "$path"; break; fi
    done
    if [[ -z $every && $path == "$smoke_list" ]]; then smoke_list_rows; fi
  done
  for row in "${names[@]}"; do
    file="scripts/smoke/rows/$row.sh"
    if ! smoke_input_read "row=$row" "$file" || [[ $smoke_glob_unmatched == true ]]; then
      want[$row]=1
    fi
    lines[$row]="${smoke_globs[*]}"
    smoke_inputs_rows "$row"
    for needed in "${smoke_inputs_named[@]}"; do
      [[ " ${names[*]} " != *" $needed "* ]] || reads[$row]+=" $needed"
    done
    for path in "$@"; do
      for glob in "$file" "${smoke_globs[@]}"; do
        [[ $path == $glob ]] || continue
        want[$row]=1
        # A smoke row file it reads changed: the change edits the row.
        if [[ $path == scripts/smoke/rows/* ]]; then edited[$row]=1; break 2; fi
        break
      done
    done
  done
  for needed in "${unlisted[@]}"; do
    for row in "${names[@]}"; do
      [[ " ${lines[$row]-} " != *" scripts/smoke/rows/$needed.sh "* ]] || want[$row]=1
    done
  done
  smoke_reads_check "${names[@]}"
  if [[ -n $every ]]; then
    printf 'validate: smoke-rows=all %s\n' "$every" >&2; return 0
  fi
  # A row over the lane bound leaves the selection unless it is a core row
  # or the change edits it: its own file, a row file its line names, or its
  # line in the row list. The closure below brings it back when a row that
  # stays reads it.
  if smoke_secs_read; then
    for row in "${!want[@]}"; do
      secs="${smoke_secs[$row]-}"
      [[ -n $secs && $secs -gt $smoke_bound_secs ]] || continue
      [[ " ${smoke_core[*]} " != *" $row "* ]] || continue
      [[ -z ${edited[$row]-} ]] || continue
      over+=("$row")
    done
    for row in "${over[@]}"; do unset "want[$row]"; done
  fi
  # A row that runs brings the rows it reads, and theirs in turn.
  count=-1
  while [[ $count -ne ${#want[@]} ]]; do
    count=${#want[@]}
    for row in "${!want[@]}"; do
      for needed in ${reads[$row]-}; do want[$needed]=1; done
    done
  done
  for row in "${names[@]}"; do
    [[ " ${over[*]} " == *" $row "* && -z ${want[$row]-} ]] || continue
    skipped+=("$row")
    printf 'validate: smoke-row skipped=over-bound row=%s secs=%s bound=%s\n' "$row" "${smoke_secs[$row]}" "$smoke_bound_secs" >&2
  done
  if [[ ${#want[@]} -eq ${#names[@]} ]]; then
    printf 'validate: smoke-rows=all reason=every-row-reached total=%s\n' "${#names[@]}" >&2; return 0
  fi
  printf 'validate: smoke-rows=some selected=%s total=%s skipped=%s\n' "${#want[@]}" "${#names[@]}" "${#skipped[@]}" >&2
  for row in "${names[@]}"; do
    [[ -z ${want[$row]-} ]] || smoke_only+="${smoke_only:+,}$row"
  done
}

# smoke_reads_named: the function and variable check as a row that fails.
# It reads the lines smoke_rows_selected prints for no changed path, in a
# subshell, so the selection it makes there reaches no caller. A
# `function=`, `variable=` or `unparsed` line fails the row; `reads=unreadable`
# or a reason that returns before the scan, a row list, core row or tracked
# list this cannot read, means the scan did not run, which is exit 77 and
# not a pass. A line of another kind, such as a glob that matches nothing,
# still selects its row on every change and fails nothing here.
smoke_reads_named() {
  local out line status=0
  local gap='^validate: smoke-input (row=[^ ]+ (function|variable)=|unparsed path=)'
  local unread='^validate: (smoke-input reads=unreadable|smoke-rows=all reason=(row-list-unreadable|core-row-missing|tracked-list-unreadable))'
  if ! out="$(smoke_rows_selected 2>&1 >/dev/null)"; then
    printf 'smoke-reads: selector=failed\n%s\n' "$out" >&2; return 77
  fi
  while IFS= read -r line; do
    if [[ $line =~ $gap ]]; then
      printf '%s\n' "$line" >&2; status=1
    elif [[ $line =~ $unread ]]; then
      printf '%s\n' "$line" >&2
      [[ $status -ne 0 ]] || status=77
    fi
  done <<<"$out"
  return "$status"
}

# The file that records this area's last pass, in the worktree's own git
# directory, so no other worktree reads it. Empty when git names no git
# directory: then no run reads or records a pass.
if ! pass_record="$(git rev-parse --absolute-git-dir)/vgs-validated-$area"; then pass_record=""; fi

# last_pass: the newest commit after the branch point whose tree is the
# tree pass_record holds, printed on stdout: the commit that holds what the
# area's last passing run read, whether that run read it committed or not.
# An absent record returns 1 silently. A record that names no tree, a
# tree no such commit holds, as after a rebase or on another branch, or a
# commit whose scripts/validate differs from the worktree's prints
# `validate: last-pass=ignored reason=<reason>` on stderr and returns 1, so
# the branch point serves; so does a branch point that cannot be read,
# whose own reader then names what is missing. The selector check holds
# the base sound: a pass proves the rows its own table selected, so a
# table that now maps a path the branch changed before the pass must read
# the whole branch again.
last_pass() {
  local recorded point commits commit tree status=0
  [[ -n $pass_record && -e $pass_record ]] || return 1
  if ! recorded="$(<"$pass_record")" || [[ ! $recorded =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] ||
     [[ "$(git cat-file -t "$recorded" 2>/dev/null)" != tree ]]; then
    printf 'validate: last-pass=ignored reason=unreadable path=%s\n' "$pass_record" >&2; return 1
  fi
  point="$(branch_point)" || return 1
  if ! commits="$(git rev-list --topo-order --format='%H %T' --no-commit-header "$point..HEAD")"; then
    printf 'validate: last-pass=ignored reason=history-unreadable tree=%s\n' "$recorded" >&2; return 1
  fi
  while read -r commit tree; do
    [[ $tree == "$recorded" ]] && break
  done <<<"$commits"
  if [[ $tree != "$recorded" ]]; then
    printf 'validate: last-pass=ignored reason=no-commit-holds-tree tree=%s\n' "$recorded" >&2; return 1
  fi
  git diff --quiet "$commit" -- scripts/validate || status=$?
  case "$status" in
    0) printf '%s\n' "$commit" ;;
    1) printf 'validate: last-pass=ignored reason=selector-changed commit=%s\n' "$commit" >&2; return 1 ;;
    *) printf 'validate: last-pass=ignored reason=selector-unreadable commit=%s status=%s\n' "$commit" "$status" >&2; return 1 ;;
  esac
}

# worktree_tree: the tree id of what a run reads, every tracked and
# untracked, non-ignored file as the worktree holds it, built in a
# scratch_index; a clean worktree gives HEAD's tree. Prints `unreadable`
# when git cannot build it.
worktree_tree() {
  local scratch tree
  if ! scratch="$(scratch_index)"; then echo unreadable; return 0; fi
  tree="$(GIT_INDEX_FILE="$scratch" git write-tree)" || tree=unreadable
  rm -f -- "${scratch:?}" "${scratch:?}.lock"
  printf '%s\n' "$tree"
}

# last_pass_record: record, after a run that passed, the tree it read in
# pass_record. A run proves its tree only when its base did: the branch
# point, an earlier pass or --full. A base a caller named is the caller's
# claim, so that run records nothing. The tree is what passed only when
# worktree_tree read the same tree at the run's start (pass_tree) and its
# end. Prints `validate: last-pass=recorded` or `last-pass=unrecorded
# reason=<reason>` on stderr; a run that records nothing keeps its exit
# status, since the next run's branch point selects more, never less.
last_pass_record() {
  local tree
  case "$base_source" in
    merge-base|last-pass|full) ;;
    argument|DEV_VALIDATE_BASE|VGS_VALIDATE_BASE)
      printf 'validate: last-pass=unrecorded reason=named-base source=%s\n' "$base_source" >&2; return 0 ;;
    *) printf 'validate: internal-error base-source=%s\n' "$base_source" >&2; exit 1 ;;
  esac
  tree="$(worktree_tree)"
  if [[ $pass_tree == unreadable || $tree == unreadable ]]; then
    echo 'validate: last-pass=unrecorded reason=tree-unreadable' >&2; return 0
  fi
  if [[ $tree != "$pass_tree" ]]; then
    printf 'validate: last-pass=unrecorded reason=content-changed from=%s to=%s\n' "$pass_tree" "$tree" >&2; return 0
  fi
  if [[ -z $pass_record ]]; then
    echo 'validate: last-pass=unrecorded reason=git-dir-unresolved' >&2; return 0
  fi
  if ! printf '%s\n' "$tree" >"${pass_record:?}.$$" || ! mv -f -- "${pass_record:?}.$$" "$pass_record"; then
    rm -f -- "${pass_record:?}.$$"
    printf 'validate: last-pass=unrecorded reason=write-failed path=%s\n' "$pass_record" >&2; return 0
  fi
  printf 'validate: last-pass=recorded area=%s tree=%s\n' "$area" "$tree" >&2
}

# The change base and its source, the first that holds: --changed BASE
# (argument); DEV_VALIDATE_BASE, the fix-round base Kendex supplies;
# VGS_VALIDATE_BASE; this area's last pass in this worktree (last-pass);
# the branch point (merge-base). --full reads no base (full).
# Match all rows before filtering by area, so runtime-only inputs do not
# cause an offline run to select unrelated suites.
if [[ -n $change_base ]]; then
  base_source=argument
elif [[ $full_scope == true ]]; then
  base_source=full
elif [[ -n ${DEV_VALIDATE_BASE:-} ]]; then
  change_base="$DEV_VALIDATE_BASE"; base_source=DEV_VALIDATE_BASE
elif [[ -z ${VGS_VALIDATE_BASE:-} ]] && change_base="$(last_pass)"; then
  base_source=last-pass
elif ! change_base="$(whitespace_base)"; then
  printf 'validate: status=not-measured reason=no-base %s\n' "${change_base##*$'\n'}" >&2
  exit 77
elif [[ -n ${VGS_VALIDATE_BASE:-} ]]; then
  base_source=VGS_VALIDATE_BASE
else
  base_source=merge-base
fi
if [[ -n $change_base ]]; then
  export VGS_VALIDATE_BASE="$change_base"
  if ! base_commit="$(git rev-parse --verify --quiet "$change_base^{commit}")"; then base_commit="$change_base"; fi
  printf 'validate: base=%s source=%s\n' "$base_commit" "$base_source" >&2
fi

# rebased_scope FILE: when the change base is a commit HEAD no longer holds,
# as after a rebase moved the branch onto a newer main, keep in FILE, the
# NUL-delimited changed paths, only the paths the branch itself changes:
# against its branch point before (the base's) or now (the worktree's), or
# untracked. Main's changes in between are the batch run's, and the paths
# the branch changes, main's edits to them included, still select. A base
# HEAD holds keeps every path. Prints `validate: scope=rebased base=<commit>
# old-point=<commit> point=<commit>`; returns 1 when a point or a diff
# cannot be read, and the caller then selects the full area.
rebased_scope() { # FILE
  local file="$1" old_point point path status=0
  local -a paths own_paths
  local -A own=()
  git merge-base --is-ancestor "$base_commit" HEAD 2>/dev/null || status=$?
  [[ $status -eq 1 ]] || return 0
  if ! old_point="$(branch_point "$base_commit")" || ! point="$(branch_point)"; then
    printf 'validate: scope=unreadable reason=branch-point base=%s\n' "$base_commit" >&2; return 1
  fi
  if ! mapfile -d '' -t own_paths < <(git diff --name-only --no-renames -z "$old_point" "$base_commit" -- &&
       git diff --name-only --no-renames -z "$point" -- && git ls-files -z --others --exclude-standard) || ! wait "$!" ||
     ! mapfile -d '' -t paths <"$file"; then
    printf 'validate: scope=unreadable reason=diff base=%s\n' "$base_commit" >&2; return 1
  fi
  for path in "${own_paths[@]}"; do own[$path]=1; done
  for path in "${paths[@]}"; do
    [[ -z ${own[$path]-} ]] || printf '%s\0' "$path"
  done >"$file"
  printf 'validate: scope=rebased base=%s old-point=%s point=%s\n' "$base_commit" "$old_point" "$point" >&2
}
# The tree a passing run records is read before the diff that selects its
# rows, so an edit after that diff changes the end tree and records nothing.
[[ $list_only == true ]] || pass_tree="$(worktree_tree)"
unset VGS_VALIDATE_CHANGED
smoke_scoped=false
affected=()
for i in "${!rows[@]}"; do affected[i]=true; done
if [[ -n $change_base ]]; then
  paths_file="$(scratch_file)"
  trap 'rm -f -- "${paths_file:?}"' EXIT
  if ! git diff --name-only --no-renames -z "$change_base" -- >"$paths_file" ||
     ! git ls-files -z --others --exclude-standard >>"$paths_file" ||
     ! rebased_scope "$paths_file"; then
    echo 'validate: selection=full reason=diff-unreadable' >&2
  else
    mapfile -d '' -t changed_paths <"$paths_file"
    for i in "${!rows[@]}"; do affected[i]=false; done
    full=false
    for path in "${changed_paths[@]}"; do
      known=false
      for i in "${!rows[@]}"; do
        IFS='|' read -r row_area label command inputs <<<"${rows[i]}"
        [[ $row_area == repo ]] && continue
        # Command words without a slash, such as node, are not inputs.
        read -r -a patterns <<<"$inputs"
        read -r -a words <<<"$command"
        for word in "${words[@]}"; do
          if [[ $word == */* ]]; then patterns+=("$word"); fi
        done
        for pattern in "${patterns[@]}"; do
          [[ $pattern == [\$@]* ]] && continue
          if [[ $path == $pattern ]]; then affected[i]=true; known=true; break; fi
        done
      done
      if [[ $known == false ]]; then
        # A removed test has no remaining command to run. Its mapped
        # consumers above still run; other unmapped inputs select full.
        if [[ $path == scripts/test-* && ! -e $path && ! -L $path ]]; then continue; fi
        case "$path" in
          *.md|*.markdown|LICENSE|docs/*|.gitignore|.kendex*|kendex*.toml|.claude/*|.codex/*|.pi/*|.github/*) ;;
          .agents/skills/vgs-plugin/*)
            printf 'validate: selection=full unknown-input=%q\n' "$path" >&2; full=true; break ;;
          .agents/*|.bot-instructions/*) ;;
          *) printf 'validate: selection=full unknown-input=%q\n' "$path" >&2; full=true; break ;;
        esac
      fi
    done
    if [[ $full == true ]]; then
      for i in "${!rows[@]}"; do affected[i]=true; done
    else
      export VGS_VALIDATE_CHANGED="$paths_file"
      smoke_scoped=true
    fi
  fi
fi

selected_count=0
selected=()
row_command=()
validate_started=$SECONDS
for i in "${!rows[@]}"; do
  IFS='|' read -r row_area label command inputs <<<"${rows[i]}"
  case "$area" in
    all) ;;
    offline) [[ $row_area == qml || $row_area == unit || $row_area == nix || $row_area == package ]] && continue ;;
    *) [[ $area != "$row_area" ]] && continue ;;
  esac
  [[ ${affected[i]} == true || $row_area == repo ]] || continue
  if [[ $skip_unprepared == true ]]; then
    unprepared=""
    read -r -a patterns <<<"$inputs"
    for pattern in "${patterns[@]}"; do
      name="${pattern#\$}"
      if [[ $pattern == \$* && -z ${!name:-} ]]; then unprepared="$name"; break; fi
    done
    if [[ -n $unprepared ]]; then
      printf 'validate: unselected unset=%s row=%s\n' "$unprepared" "$label" >&2
      unselected=true
      continue
    fi
  fi
  selected_count=$((selected_count + 1))
  if [[ $command == scripts/qml-smoke.sh && $smoke_scoped == true ]]; then
    smoke_rows_selected "${changed_paths[@]}"
    [[ -z $smoke_only ]] || command+=" --rows $smoke_only"
  fi
  if [[ $list_only == true ]]; then
    printf '%s\n' "$command"
  else
    selected+=("$i")
    row_command+=("$command")
  fi
done
if [[ $list_only == true ]]; then
  printf 'validate: selected=%s area=%s\n' "$selected_count" "$area" >&2
  exit 0
fi

# The run loop: the selected rows run side by side, at most jobs_max at once,
# each as a job in a process group of its own, so a signal reaches every
# process a row started. A row waits while a running row names one of its
# `@NAME`s; an `@alone` row starts once nothing runs, and no row after it
# in the table starts before it has ended. An `@alone` row, and every row
# at one job, starts once every row before it has printed, so it writes to
# validate's own stdout and stderr as it runs; any other row writes both to
# its log, which prints whole once every row before it has printed. The
# statuses fill failed and skipped in table order.
run_dir="$(scratch_dir)" || { echo 'validate: run-dir=scratch-failed' >&2; exit 1; }
declare -A row_of_pid=() held=()
row_state=() row_alone=() row_locks=() row_status=()
for k in "${!selected[@]}"; do
  IFS='|' read -r _ _ _ inputs <<<"${rows[selected[k]]}"
  read -r -a patterns <<<"$inputs"
  row_state[k]=pending row_alone[k]=false row_locks[k]=""
  for pattern in "${patterns[@]}"; do
    case "$pattern" in
      @alone) row_alone[k]=true ;;
      @*) row_locks[k]+=" ${pattern#@}" ;;
    esac
  done
done
start_row() { # K
  local k="$1" row_area label name
  IFS='|' read -r row_area label _ <<<"${rows[selected[k]]}"
  # Job control, on only while the job starts, gives it its own process
  # group and leaves its INT and QUIT at their defaults, which a bare `&`
  # would ignore and the Ctrl-C checks of the fence and TUI rows need.
  set -m
  if [[ ${row_alone[k]} == true || $jobs_max -eq 1 ]]; then
    # shellcheck disable=SC2086
    run "$run_dir/$k" "$row_area" "$label" ${row_command[k]} </dev/null &
  else
    # shellcheck disable=SC2086
    run "$run_dir/$k" "$row_area" "$label" ${row_command[k]} </dev/null >"$run_dir/$k.log" 2>&1 &
  fi
  set +m
  row_of_pid[$!]=$k
  row_state[k]=running
  for name in ${row_locks[k]}; do held[$name]=1; done
}
start_rows() {
  local k pid name
  for pid in "${!row_of_pid[@]}"; do
    k="${row_of_pid[$pid]}"
    [[ ${row_alone[k]} == false ]] || return 0
  done
  for k in "${!selected[@]}"; do
    [[ ${row_state[k]} == pending ]] || continue
    if [[ ${row_alone[k]} == true ]]; then
      [[ ${#row_of_pid[@]} -gt 0 ]] || start_row "$k"
      return 0
    fi
    [[ ${#row_of_pid[@]} -lt $jobs_max ]] || return 0
    for name in ${row_locks[k]}; do
      [[ -z ${held[$name]-} ]] || continue 2
    done
    start_row "$k"
  done
}
# stop_rows, run by the EXIT trap however validate ends, sends TERM to the
# group of every job still running, a row started but not yet recorded
# included, then KILL to the groups still alive after 10 s, which outlasts
# the smoke's own TERM-then-KILL teardown, or at once on a repeat signal.
# A group is taken only while its leader is still validate's child, since a
# job bash has already reaped can leave its number to another process; once
# taken, the kernel keeps the group's number while any member lives, so the
# KILL still reaches members whose leader the TERM ended.
row_groups=()
stopping=false
kill_groups() { # SIGNAL
  local pid
  for pid in "${row_groups[@]}"; do kill -s "$1" -- "-$pid" 2>/dev/null || true; done
  return 0
}
stop_rows() {
  local pid stat ppid pgrp alive tick
  local -a pids=()
  stopping=true
  jobs -p >"$run_dir/jobs" 2>/dev/null && mapfile -t pids <"$run_dir/jobs" || return 0
  for pid in "${pids[@]}"; do
    read -r stat 2>/dev/null <"/proc/$pid/stat" || continue
    read -r _ ppid pgrp _ <<<"${stat##*) }"
    if [[ $ppid == "$$" && $pgrp == "$pid" ]]; then row_groups+=("$pid"); fi
  done
  [[ ${#row_groups[@]} -gt 0 ]] || return 0
  kill_groups TERM
  for ((tick = 0; tick < 100; tick++)); do
    alive=false
    for pid in "${row_groups[@]}"; do
      if kill -0 -- "-$pid" 2>/dev/null; then alive=true; fi
    done
    [[ $alive == true ]] || return 0
    sleep 0.1
  done
  kill_groups KILL
}
# A signal exits through the EXIT trap; one that arrives while the rows are
# being stopped KILLs their groups instead of ending validate mid-stop.
on_signal() { # EXIT-STATUS
  if [[ $stopping == true ]]; then kill_groups KILL; return 0; fi
  exit "$1"
}
trap 'stop_rows; chmod -R u+rwx -- "$run_dir" 2>/dev/null; rm -rf -- "${run_dir:?}"; if [[ -n ${paths_file:-} ]]; then rm -f -- "$paths_file"; fi' EXIT
trap 'on_signal 130' INT
trap 'on_signal 143' TERM
trap 'on_signal 129' HUP
trap 'on_signal 131' QUIT
printed=0
while :; do
  start_rows
  [[ ${#row_of_pid[@]} -gt 0 ]] || break
  pid="" status=0
  wait -n -p pid || status=$?
  if [[ -z $pid ]]; then
    printf 'validate: wait=no-child status=%s running=%s\n' "$status" "${#row_of_pid[@]}" >&2; exit 1
  fi
  # Only a row's job counts; any other child is passed over.
  [[ -n ${row_of_pid[$pid]-} ]] || continue
  k="${row_of_pid[$pid]}"
  unset 'row_of_pid[$pid]'
  row_state[k]=ended row_status[k]=$status
  for name in ${row_locks[k]}; do unset 'held[$name]'; done
  while [[ $printed -lt ${#selected[@]} && ${row_state[printed]} == ended ]]; do
    IFS='|' read -r _ label _ <<<"${rows[selected[printed]]}"
    if [[ ${row_alone[printed]} == false && $jobs_max -gt 1 ]]; then
      cat -- "$run_dir/$printed.log" || true
    fi
    case "${row_status[printed]}" in
      0) ;;
      77) skipped+=("$label") ;;
      *) failed+=("$label (exit ${row_status[printed]})") ;;
    esac
    printed=$((printed + 1))
  done
done
trap - INT TERM HUP QUIT
printf 'validate: selected=%s area=%s secs=%s\n' "$selected_count" "$area" "$((SECONDS - validate_started))" >&2

if [[ ${#failed[@]} -gt 0 ]]; then
  printf 'validate: failed=%s\n' "$(IFS=';'; echo "${failed[*]}")"
  exit 1
fi
if [[ ${#skipped[@]} -gt 0 ]]; then
  printf 'validate: status=not-measured skipped=%s\n' "$(IFS=';'; echo "${skipped[*]}")"
  exit 77
fi
if [[ $unselected == true ]]; then
  echo 'validate: last-pass=unrecorded reason=unselected' >&2
else
  last_pass_record
fi
echo "validate: ok"
